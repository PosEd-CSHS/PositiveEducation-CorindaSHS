const totals={chicken:3,alpaca:2,goat:1,phoenix:1,suit:1,kangaroo:1,redtree:1,mangrove:1,snake:1,eagle:1,horse:1,cow:1,farmer:1,scientist:1,drummer:1,soccer:1,dancer:1};
EVENT_EXTRAS.forEach(t=>{ totals[t.key]=t.count; });   // add this edition's findable extras
