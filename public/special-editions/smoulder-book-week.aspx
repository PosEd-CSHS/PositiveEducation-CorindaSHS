  ctx.beginPath();ctx.moveTo(s*0.3,-s*0.42);ctx.bezierCurveTo(s*0.5,-s*0.5,s*0.5,-s*0.3,s*0.3,-s*0.36);ctx.stroke();ctx.restore();}

function drawPancake(x,y,s){ctx.save();ctx.translate(x,y);ctx.fillStyle='rgba(0,0,0,0.15)';ctx.beginPath();ctx.ellipse(0,s*0.04,s*0.34,s*0.05,0,0,Math.PI*2);ctx.fill();
  for(let i=0;i<3;i++){const yy=-s*0.08-i*s*0.16;ctx.fillStyle=i%2?'#e8b860':'#f0c878';
