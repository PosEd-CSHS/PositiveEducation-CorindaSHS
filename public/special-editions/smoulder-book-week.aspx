function drawWand(x,y,s){ctx.save();ctx.translate(x,y);ctx.fillStyle='rgba(0,0,0,0.15)';ctx.beginPath();ctx.ellipse(0,s*0.04,s*0.22,s*0.05,0,0,Math.PI*2);ctx.fill();
  ctx.strokeStyle='#6e4a28';ctx.lineWidth=s*0.05;ctx.lineCap='round';
  ctx.beginPath();ctx.moveTo(-s*0.12,-s*0.02);ctx.lineTo(s*0.2,-s*0.8);ctx.stroke();
  ctx.fillStyle='#ffd23c';
  const cx=s*0.22,cy=-s*0.86,r=s*0.16;
  ctx.beginPath();
  for(let i=0;i<10;i++){const ang=Math.PI/2+i*Math.PI/5;const rr=i%2===0?r:r*0.42;ctx.lineTo(cx+Math.cos(ang)*rr,cy-Math.sin(ang)*rr);}
  ctx.closePath();ctx.fill();
  ctx.fillStyle='#fff3b0';
  [[-s*0.02,-s*0.3,s*0.025],[s*0.06,-s*0.5,s*0.02],[-s*0.08,-s*0.14,s*0.018]].forEach(([sx,sy,sr])=>{ctx.beginPath();ctx.arc(sx,sy,sr,0,Math.PI*2);ctx.fill();});
  ctx.restore();}

function rChoice(arr){return arr[rInt(0,arr.length)]}
function rF(a,b){return rand()*(b-a)+a}

