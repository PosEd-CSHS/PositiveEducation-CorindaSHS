  // hair — short, under headband
  ctx.fillStyle=rChoice(['#1a0a00','#3a2010','#222']);
  ctx.beginPath();ctx.ellipse(0,-s*0.4,s*0.21,s*0.12,0,0,Math.PI*2);ctx.fill();
  ctx.fillRect(-s*0.21,-s*0.38,s*0.42,s*0.08);
  // headband — white
  ctx.fillStyle=kitAccent;ctx.fillRect(-s*0.21,-s*0.3,s*0.42,s*0.04);
  // eyes
  ctx.fillStyle='#1a0a00';ctx.beginPath();ctx.arc(-s*0.07,-s*0.22,s*0.03,0,Math.PI*2);ctx.fill();
  ctx.beginPath();ctx.arc(s*0.07,-s*0.22,s*0.03,0,Math.PI*2);ctx.fill();
  ctx.fillStyle='rgba(255,255,255,0.8)';ctx.beginPath();ctx.arc(-s*0.06,-s*0.24,s*0.012,0,Math.PI*2);ctx.fill();
  ctx.beginPath();ctx.arc(s*0.08,-s*0.24,s*0.012,0,Math.PI*2);ctx.fill();
  // determined mouth
  ctx.strokeStyle='#8a5030';ctx.lineWidth=s*0.025;
  ctx.beginPath();ctx.moveTo(-s*0.06,-s*0.12);ctx.lineTo(s*0.06,-s*0.12);ctx.stroke();
  ctx.restore();
}

function drawDancer(x,y,s){
  ctx.save();ctx.translate(x,y);
  const skin=rChoice(['#f5d0a0','#e8b87a','#c8895a','#a0623a','#f0c898']);
  const hair=rChoice(['#1a0a00','#3a2010','#c8a050','#8a5030']);
  const dressCol='#111';
  const dressAccent='#333';
  // shadow
  ctx.fillStyle='rgba(0,0,0,0.15)';ctx.beginPath();ctx.ellipse(0,s,s*0.32,s*0.08,0,0,Math.PI*2);ctx.fill();
  // DANCE SHOES — black character shoes with small heel
  ctx.fillStyle='#111';
  ctx.beginPath();ctx.roundRect(-s*0.2,s*0.9,s*0.2,s*0.1,s*0.03);ctx.fill();
  ctx.beginPath();ctx.roundRect(s*0.02,s*0.9,s*0.2,s*0.1,s*0.03);ctx.fill();
  // ribbon ties up the leg — silver/white for contrast against black
  ctx.strokeStyle='#aaa';ctx.lineWidth=s*0.02;
  ctx.beginPath();ctx.moveTo(-s*0.1,s*0.9);ctx.lineTo(-s*0.14,s*0.7);ctx.stroke();
  ctx.beginPath();ctx.moveTo(s*0.12,s*0.9);ctx.lineTo(s*0.08,s*0.7);ctx.stroke();
  // DANCE POSE — one leg extended to the side
  // standing leg
  ctx.fillStyle=skin;ctx.fillRect(-s*0.12,s*0.55,s*0.15,s*0.38);
  // extended leg — kicked out to side/up
  ctx.save();ctx.translate(s*0.14,s*0.64);ctx.rotate(0.7);
  ctx.fillStyle=skin;ctx.fillRect(-s*0.07,0,s*0.14,s*0.32);
  ctx.restore();
  // DRESS — flared tutu-style
  // underskirt layers
  ctx.fillStyle=dressAccent;
  ctx.beginPath();ctx.moveTo(-s*0.38,s*0.5);ctx.bezierCurveTo(-s*0.5,s*0.38,-s*0.3,s*0.28,-s*0.05,s*0.38);
  ctx.lineTo(0,s*0.42);ctx.lineTo(s*0.05,s*0.38);ctx.bezierCurveTo(s*0.3,s*0.28,s*0.5,s*0.38,s*0.38,s*0.5);ctx.fill();
  // main dress skirt
  ctx.fillStyle=dressCol;
  ctx.beginPath();ctx.moveTo(-s*0.3,s*0.5);ctx.bezierCurveTo(-s*0.42,s*0.38,-s*0.26,s*0.3,s*0.0,s*0.38);
  ctx.bezierCurveTo(s*0.26,s*0.3,s*0.42,s*0.38,s*0.3,s*0.5);ctx.fill();
  // sequin shimmer on dress
  ctx.fillStyle='rgba(255,255,255,0.25)';
  [-s*0.15,0,s*0.15].forEach(sx=>{
    [s*0.32,s*0.42].forEach(sy=>{ctx.beginPath();ctx.arc(sx,sy,s*0.025,0,Math.PI*2);ctx.fill();});
  });
  // bodice
  ctx.fillStyle=dressCol;ctx.beginPath();ctx.roundRect(-s*0.22,s*0.08,s*0.44,s*0.34,s*0.04);ctx.fill();
  // bodice sparkle detail
  ctx.fillStyle=dressAccent;
  ctx.fillRect(-s*0.06,s*0.1,s*0.12,s*0.06);
  [s*0.16,s*0.24].forEach(by=>{
    ctx.beginPath();ctx.arc(0,by,s*0.03,0,Math.PI*2);ctx.fill();
  });
  // ARMS — graceful dance pose
  // left arm up and arched
  ctx.fillStyle=skin;
  ctx.save();ctx.translate(-s*0.22,s*0.1);ctx.rotate(-0.8);
  ctx.beginPath();ctx.roundRect(-s*0.07,0,s*0.14,s*0.34,s*0.06);ctx.fill();
  ctx.restore();
  ctx.fillStyle=skin;ctx.beginPath();ctx.arc(-s*0.46,-s*0.08,s*0.1,0,Math.PI*2);ctx.fill(); // raised hand
  // right arm out
  ctx.save();ctx.translate(s*0.22,s*0.14);ctx.rotate(0.4);
  ctx.fillStyle=skin;ctx.beginPath();ctx.roundRect(-s*0.07,0,s*0.14,s*0.28,s*0.06);ctx.fill();
  ctx.restore();
  ctx.fillStyle=skin;ctx.beginPath();ctx.arc(s*0.44,s*0.36,s*0.1,0,Math.PI*2);ctx.fill();
  // neck + head
  ctx.fillStyle=skin;ctx.fillRect(-s*0.09,-s*0.06,s*0.18,s*0.16);
  ctx.beginPath();ctx.ellipse(0,-s*0.22,s*0.19,s*0.22,0,0,Math.PI*2);ctx.fill();
  // HAIR — up in a bun with sparkly hairpiece
  ctx.fillStyle=hair;
  ctx.beginPath();ctx.ellipse(0,-s*0.4,s*0.19,s*0.12,0,0,Math.PI*2);ctx.fill();
  ctx.fillRect(-s*0.19,-s*0.38,s*0.38,s*0.08);
  // bun
  ctx.beginPath();ctx.arc(s*0.06,-s*0.48,s*0.1,0,Math.PI*2);ctx.fill();
  // sparkly hair pin
  ctx.fillStyle='#f2b400';ctx.beginPath();ctx.arc(s*0.14,-s*0.52,s*0.04,0,Math.PI*2);ctx.fill();
  ctx.fillStyle='#fff';ctx.beginPath();ctx.arc(s*0.15,-s*0.53,s*0.015,0,Math.PI*2);ctx.fill();
  // eyes — expressive, with lashes
  ctx.fillStyle='#fff';ctx.beginPath();ctx.ellipse(-s*0.07,-s*0.22,s*0.05,s*0.06,0,0,Math.PI*2);ctx.fill();
  ctx.beginPath();ctx.ellipse(s*0.07,-s*0.22,s*0.05,s*0.06,0,0,Math.PI*2);ctx.fill();
  ctx.fillStyle='#1a0a00';ctx.beginPath();ctx.arc(-s*0.065,-s*0.22,s*0.035,0,Math.PI*2);ctx.fill();
  ctx.beginPath();ctx.arc(s*0.075,-s*0.22,s*0.035,0,Math.PI*2);ctx.fill();
  // lashes
  ctx.strokeStyle='#1a0a00';ctx.lineWidth=s*0.015;
  [-s*0.1,-s*0.07,-s*0.04].forEach(lx=>{ctx.beginPath();ctx.moveTo(lx,-s*0.27);ctx.lineTo(lx-s*0.01,-s*0.32);ctx.stroke();});
  [s*0.04,s*0.07,s*0.1].forEach(lx=>{ctx.beginPath();ctx.moveTo(lx,-s*0.27);ctx.lineTo(lx+s*0.01,-s*0.32);ctx.stroke();});
  // smile
  ctx.strokeStyle='#c8402a';ctx.lineWidth=s*0.025;
  ctx.beginPath();ctx.arc(0,-s*0.12,s*0.06,0.1,Math.PI-0.1);ctx.stroke();
  // lipstick
  ctx.fillStyle='#c8402a';ctx.beginPath();ctx.ellipse(0,-s*0.1,s*0.04,s*0.02,0,0,Math.PI*2);ctx.fill();
  ctx.restore();
}

function allRequiredTargetsFound(){
  return Object.keys(totals).every(key => (foundSets[key] || 0) >= totals[key]);
}

function render(){
  // Rebuild click targets from scratch on each redraw, preserving found state by id.
  clickTargets=[];
  targetOrdinals={};
  ctx.clearRect(0,0,W,H);

  // ── PHASE 1: draw background (buildings, trees, retaining wall, ground) ──
  // But we need to intercept the drawing order so some chars appear BEHIND trees.
  // Strategy: draw background in two parts via drawBackground(),
  // then redraw trees on top of some chars.

  seed=SESSION_SEED;
  const crowdPositions=generateCrowdPositions();
  const total=crowdPositions.length;
  function pickIdx(low,high){return rInt(Math.floor(total*low),Math.floor(total*high));}

  // Assign hidden char slots — fixed positions across the scene
  const hiddenSlots={
    chicken:  [pickIdx(0.05,0.13), pickIdx(0.47,0.54), pickIdx(0.83,0.90)],
    alpaca:   [pickIdx(0.22,0.30), pickIdx(0.66,0.74)],
    goat:     [pickIdx(0.14,0.20)],
    phoenix:  [pickIdx(0.41,0.47)],
    suit:     [pickIdx(0.32,0.37)],
    kangaroo: [pickIdx(0.10,0.15)],
    redtree:  [pickIdx(0.56,0.60)],
    mangrove: [pickIdx(0.75,0.79)],
    snake:    [pickIdx(0.85,0.89)],
    eagle:    [pickIdx(0.24,0.28)],
    horse:    [pickIdx(0.90,0.94)],
    cow:      [pickIdx(0.16,0.21)],
    farmer:   [pickIdx(0.44,0.49)],
    scientist:[pickIdx(0.62,0.67)],
    drummer:  [pickIdx(0.35,0.40)],
    soccer:   [pickIdx(0.77,0.82)],
    dancer:   [pickIdx(0.55,0.60)],
  };
  // Add this edition's findable extras, scattered across the scene.
  EVENT_EXTRAS.forEach(t=>{
    hiddenSlots[t.key] = Array.from({length: t.count}, () => pickIdx(0.05, 0.95));
  });

  // ── Guarantee distinct slots ──
  // The pickIdx ranges above overlap, so two characters can roll the same crowd
  // index and end up drawn on top of each other — making one unclickable and the
  // game unwinnable. Walk every assigned index in order; if it's already taken,
  // nudge to the nearest free crowd index so all hidden chars occupy unique slots.
  const usedIdx=new Set();
  const claim=(idx)=>{
    idx=Math.max(0,Math.min(total-1,idx));
    if(!usedIdx.has(idx)){usedIdx.add(idx);return idx;}
    for(let d=1;d<total;d++){
      if(idx-d>=0 && !usedIdx.has(idx-d)){usedIdx.add(idx-d);return idx-d;}
      if(idx+d<total && !usedIdx.has(idx+d)){usedIdx.add(idx+d);return idx+d;}
    }
    usedIdx.add(idx);return idx; // fallback (should never happen: total >> 20)
  };
  Object.keys(hiddenSlots).forEach(key=>{
    hiddenSlots[key]=hiddenSlots[key].map(claim);
  });

  const hiddenIdxSet=new Set();
  Object.values(hiddenSlots).flat().forEach(i=>hiddenIdxSet.add(i));

  // Reset seed so positions match the first crowd generation
  seed=SESSION_SEED;
  const cp2=generateCrowdPositions();

  // Collect hidden char draw info
  const hiddenDrawList=[];
  Object.entries(hiddenSlots).forEach(([key,idxArr])=>{
    idxArr.forEach((idx,i)=>{
      const pos=cp2[idx]||{x:rF(100,W-100),y:rF(500,H-100),size:28,junior:rand()>0.5};
      hiddenDrawList.push({key,x:pos.x,y:pos.y,s:pos.size,junior:pos.junior,genderIdx:i%2,idx});
    });
  });

  // ── Visibility assignment ──
  // Hidden characters must be fully visible and clickable for fair house competition play.
  // Tree occlusion has been disabled so no findable character is deliberately drawn behind
  // the large tree canopies.
  hiddenDrawList.forEach(h=>{
    h.occludeBy='none';
    delete h.treeX;
  });

  // Clamp all hidden chars to be fully on-screen with margin and below the tree canopy zone.
  hiddenDrawList.forEach(h=>{
    const margin=h.s*1.5;
    h.x=Math.max(margin, Math.min(W-margin, h.x));
    h.y=Math.max(440, Math.min(H-margin, h.y));
  });

  // Widen click target for golf cart (it's wider than a person)
  hiddenDrawList.forEach(h=>{
    if(false) h.s=h.s; // placeholder
  });

  // ── PHASE 2: draw background ──
  drawBackground();

  // ── PHASE 3: students on amphitheatre steps ──
  [[140,362,55,true],[500,362,52,false],[980,364,55,true],
   [1500,362,52,false],[2000,364,55,true],[2600,362,52,false],
   [3050,364,52,true]].forEach(([sx,sy,ss,jr])=>{
    drawStudent(sx,sy,ss,rand()>0.5,jr);
  });

  // ── PHASE 4: draw hidden chars that should appear BEHIND trees ──
  // These will be partially covered when trees are redrawn below.
  // NOTE: click targets are NOT added here — Phase 6's merged draw list adds the
  // target for every hidden char exactly once (avoids duplicate overlapping targets).
  hiddenDrawList.forEach(h=>{
    if(h.occludeBy==='tree'){
      drawHiddenChar(h.key,h.x,h.y,h.s,h.junior,h.genderIdx,null);
    }
  });

  // ── PHASE 5: redraw trees on top of "behind-tree" hidden chars ──
  function redrawTree(tx,ty,cw,ch){
    const r=cw;
    ctx.fillStyle='rgba(0,0,0,0.1)';
    ctx.beginPath(); ctx.ellipse(tx, ty+r*0.1+28, r*0.5, r*0.1, 0, 0, Math.PI*2); ctx.fill();
    ctx.fillStyle='#6a4820'; ctx.fillRect(tx-5, ty, 10, 34);
    ctx.fillStyle='#2a6010';
    ctx.beginPath(); ctx.arc(tx+r*0.06, ty-r*0.06, r*0.96, 0, Math.PI*2); ctx.fill();
    ctx.fillStyle='#3aaa28';
    ctx.beginPath(); ctx.arc(tx, ty, r*0.9, 0, Math.PI*2); ctx.fill();
    ctx.fillStyle='#4cc838';
    ctx.beginPath(); ctx.arc(tx-r*0.2, ty-r*0.2, r*0.55, 0, Math.PI*2); ctx.fill();
    ctx.fillStyle='rgba(120,220,80,0.3)';
    ctx.beginPath(); ctx.arc(tx-r*0.25, ty-r*0.35, r*0.28, 0, Math.PI*2); ctx.fill();
  }
  const occludedTreeXs=new Set(hiddenDrawList.filter(h=>h.occludeBy==='tree').map(h=>h.treeX));
  const allTreeData=[
    [562,241,112,112],[859,235,130,130],[1505,211,124,124],
    [1848,205,130,130],[2257,211,118,118],[2660,223,100,100],[2868,223,94,94]
  ];

  // ── PHASE 6: draw crowd AND hidden chars merged, sorted by y (back-to-front) ──
  // Build index map for crowd
  const crowdIdxMap=new Map(crowdPositions.map((p,i)=>[p,i]));

  // Build combined draw list: students + hidden chars
  // Each entry has {y, drawFn}
  const drawList=[];

  // Add crowd students
  crowdPositions.forEach((pos,origIdx)=>{
    if(hiddenIdxSet.has(origIdx)) return; // skip slots reserved for hidden chars
    drawList.push({y:pos.y, fn:()=>drawStudent(pos.x,pos.y,pos.size,pos.flip,pos.junior,pos.pose||0,pos.facing||0)});
  });

  // Add hidden chars (tree-occluded ones drawn BEFORE trees, others in normal order)
  hiddenDrawList.forEach(h=>{
    if(h.occludeBy==='tree'){
      // Draw before trees get repainted — add at h.y but mark for pre-tree draw
      drawList.push({y:h.y, pre:true, fn:()=>{
        drawHiddenChar(h.key,h.x,h.y,h.s,h.junior,h.genderIdx,null);
        addTarget(h.x,h.y,h.s,h.key,h.key,h.idx);
      }});
    } else {
      drawList.push({y:h.y, fn:()=>{
        drawHiddenChar(h.key,h.x,h.y,h.s,h.junior,h.genderIdx,null);
        addTarget(h.x,h.y,h.s,h.key,h.key,h.idx);
      }});
    }
  });

  // Sort by y ascending (furthest back drawn first)
  drawList.sort((a,b)=>a.y-b.y);

  // Draw everything in order
  // Keep track of whether we've redrawn trees yet
  let treesRedrawn=false;
  const treeRedrawnSet=new Set();

  drawList.forEach(item=>{
    item.fn();
    // After drawing any tree-occluded char, immediately redraw its tree
    if(item.pre && !treeRedrawnSet.has(item.y)){
      treeRedrawnSet.add(item.y);
      const nearTree=allTreeData.reduce((a,b)=>Math.abs(b[0]-item.y)<Math.abs(a[0]-item.y)?b:a);
      // Actually use h.treeX from the hidden char — find it
    }
  });

  // Redraw trees for occluded chars
  allTreeData.forEach(([tx,ty,cw,ch])=>{
    if(occludedTreeXs.has(tx)) redrawTree(tx,ty,cw,ch);
  });

  // ── PHASE 7: Redraw retaining wall cap ──
  const wallY=320;
  ctx.fillStyle='#d0cec4';ctx.fillRect(0,wallY,W,8);
  ctx.fillStyle='rgba(0,0,0,0.18)';ctx.fillRect(0,wallY+36,W,6);

  // ── PHASE 8: atmospheric depth haze over far rows ──
  // Subtle blue-grey gradient that fades figures in the distance
  const hazeG=ctx.createLinearGradient(0,360,0,560);
  hazeG.addColorStop(0,'rgba(190,210,230,0.28)');
  hazeG.addColorStop(1,'rgba(190,210,230,0)');
  ctx.fillStyle=hazeG; ctx.fillRect(0,360,W,200);
}

// ── INTERACTION ──
const wrap=document.querySelector('.scene-wrap');

canvas.addEventListener('click',function(e){
  // Start timer on very first canvas click
  startTimer();

  const rect=canvas.getBoundingClientRect();
  const scaleX=W/rect.width;
  const scaleY=H/rect.height;
  const cx=(e.clientX-rect.left)*scaleX;
  const cy=(e.clientY-rect.top)*scaleY;

  for(const t of clickTargets){
    if(t.found || foundTargetIds.has(t.id)) continue;
    if(cx>=t.x && cx<=t.x+t.w && cy>=t.y && cy<=t.y+t.h){
      t.found=true;
      foundTargetIds.add(t.id);
      foundSets[t.key]=(foundSets[t.key]||0)+1;
      totalFound=foundTargetIds.size;
      document.getElementById('score').textContent=totalFound+' / '+TOTAL;
      if(foundSets[t.key]>=totals[t.key]){
        document.getElementById('fi-'+t.key).classList.add('found');
      }
      // flash effect
      let flashes=0;
      const fint=setInterval(()=>{
        ctx.save();
        ctx.globalAlpha=flashes%2===0?0.5:0;
        ctx.fillStyle='#2ecc71';
        ctx.fillRect(t.x,t.y,t.w,t.h);
        ctx.restore();
        flashes++;
        if(flashes>5){clearInterval(fint);render();}
      },80);

      if(allRequiredTargetsFound()){
        setTimeout(()=>{
          stopTimer();
          const score = calcScore(timerSeconds);
          document.getElementById('win-time').textContent='⏱ Your time: '+formatTime(timerSeconds);
          document.getElementById('win-score').textContent='🏆 '+score+' / 10 pts';
          document.getElementById('win').classList.add('show');
        },700);
      }
      return;
    }
  }
});

// tooltip overlay
const tip=document.createElement('div');
tip.style.cssText='position:fixed;background:#00180f;color:#f2b400;padding:4px 10px;border-radius:8px;font-size:0.72rem;font-weight:700;pointer-events:none;opacity:0;transition:opacity 0.15s;border:1px solid #f2b400;z-index:300;font-family:Nunito,sans-serif;';
document.body.appendChild(tip);

canvas.addEventListener('mousemove',function(e){
  const rect=canvas.getBoundingClientRect();
  const scaleX=W/rect.width;
  const scaleY=H/rect.height;
  const cx=(e.clientX-rect.left)*scaleX;
  const cy=(e.clientY-rect.top)*scaleY;
  let hit=false;
  for(const t of clickTargets){
    if(!t.found && !foundTargetIds.has(t.id) && cx>=t.x && cx<=t.x+t.w && cy>=t.y && cy<=t.y+t.h){
      hit=true;break;
    }
  }
  if(hit){
    canvas.style.cursor='pointer';
  } else {
    canvas.style.cursor='crosshair';
  }
});


init();
</script>
