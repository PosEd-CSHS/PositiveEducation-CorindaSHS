  ctx.beginPath();ctx.ellipse(s*0.35,-s*0.58,s*0.06,s*0.14,-0.3,0,Math.PI*2);ctx.fill();
  ctx.beginPath();ctx.ellipse(s*0.58,-s*0.58,s*0.06,s*0.14,0.3,0,Math.PI*2);ctx.fill();
  // snout
  ctx.fillStyle='#d4c4a0';
  ctx.beginPath();ctx.ellipse(s*0.62,-s*0.4,s*0.1,s*0.08,0,0,Math.PI*2);ctx.fill();
  // nostrils
  ctx.fillStyle='#a08060';
  ctx.beginPath();ctx.arc(s*0.58,-s*0.4,s*0.025,0,Math.PI*2);ctx.fill();
  ctx.beginPath();ctx.arc(s*0.66,-s*0.4,s*0.025,0,Math.PI*2);ctx.fill();
  // eye
  ctx.fillStyle='#2a1a08';
  ctx.beginPath();ctx.arc(s*0.52,-s*0.48,s*0.04,0,Math.PI*2);ctx.fill();
  ctx.fillStyle='#fff';
  ctx.beginPath();ctx.arc(s*0.54,-s*0.5,s*0.015,0,Math.PI*2);ctx.fill();
