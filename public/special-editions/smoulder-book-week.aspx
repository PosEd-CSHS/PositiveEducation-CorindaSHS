  ctx.fillText('10',0,s*0.36);
  // collar
  ctx.fillStyle=kitAccent;ctx.beginPath();ctx.arc(0,s*0.08,s*0.1,Math.PI,0);ctx.fill();
  // arms — one raised, one lower (kicking pose)
  ctx.fillStyle=kitCol;
  ctx.beginPath();ctx.roundRect(-s*0.54,s*0.06,s*0.26,s*0.26,s*0.04);ctx.fill(); // raised left
  ctx.beginPath();ctx.roundRect(s*0.3,s*0.16,s*0.24,s*0.26,s*0.04);ctx.fill();  // lower right
  ctx.fillStyle=skin;
  ctx.beginPath();ctx.arc(-s*0.41,s*0.12,s*0.11,0,Math.PI*2);ctx.fill(); // hand up
  ctx.beginPath();ctx.arc(s*0.42,s*0.44,s*0.11,0,Math.PI*2);ctx.fill();
  // KICKING LEG — extended forward
  ctx.fillStyle=kitCol;
  ctx.beginPath();ctx.roundRect(-s*0.04,s*0.46,s*0.26,s*0.24,s*0.04);ctx.fill();
  ctx.save();ctx.translate(s*0.18,s*0.72);ctx.rotate(-0.6);
  ctx.fillStyle=kitCol;ctx.fillRect(-s*0.1,0,s*0.2,s*0.32);
  ctx.fillStyle='#f0f0ee';ctx.fillRect(-s*0.1,s*0.28,s*0.2,s*0.07);
  ctx.fillStyle='#111';ctx.beginPath();ctx.roundRect(-s*0.12,s*0.34,s*0.28,s*0.12,s*0.03);ctx.fill();
  ctx.restore();
  // FOOTBALL — near the kicking foot
  ctx.fillStyle='#f0f0ee';ctx.beginPath();ctx.arc(s*0.5,s*0.85,s*0.12,0,Math.PI*2);ctx.fill();
