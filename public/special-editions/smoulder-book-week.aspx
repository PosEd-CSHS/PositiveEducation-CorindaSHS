let timerSeconds=0;
let timerRunning=false;

function toggleFindBar(){
  const bar = document.getElementById('findBar');
  const btn = document.getElementById('findBarToggleBtn');
  const collapsed = bar.classList.toggle('collapsed');
  btn.textContent = collapsed ? '▼ Show' : '▲ Hide';
}

function toggleInstructions(){
  const panel=document.getElementById('instructions-panel');
  const btn=document.querySelector('.how-btn');
  panel.classList.toggle('open');
  btn.textContent=panel.classList.contains('open')?'✖ Close':'❓ How to Play';
}

function formatTime(s){
  const m=Math.floor(s/60);
  const sec=s%60;
  return m+':'+(sec<10?'0':'')+sec;
}
function startTimer(){
  if(timerRunning) return;
  timerRunning=true;
  timerInterval=setInterval(()=>{
    timerSeconds++;
    const el=document.getElementById('timer');
    el.textContent='⏱ '+formatTime(timerSeconds);
    el.classList.toggle('urgent', timerSeconds>=600); // red after 10 min
  },1000);
}
function stopTimer(){
  clearInterval(timerInterval);
  timerRunning=false;
}
function resetTimer(){
  stopTimer();
  timerSeconds=0;
  document.getElementById('timer').textContent='⏱ 0:00';
  document.getElementById('timer').classList.remove('urgent');
}
let hiddenChars=[];
let allStudents=[];

// ── colour palettes ──
const skinTones=['#f5d0a0','#e8b87a','#c8895a','#a0623a','#7a3c1a','#f0c898','#d4956a','#fde0b8','#e0a870'];
const hairColors=['#1a0a00','#3a2010','#6b3a10','#c8a050','#d4a030','#111','#8a5030','#cc4422','#2a1a08','#4a3020','#222','#5a2a08'];
const bagColors=['#c02020','#1a4a20','#8a5010','#303030','#a04000','#186018','#8a2010','#505050'];

function drawStudent(x,y,size,flip,junior,pose=0,facing=0){
  // Character style based on reference asset sheet:
  // Large round head ~28% of total height, big eyes with shine dots,
  // clean outlines, chunky proportions, distinct poses
  // Juniors: white/green stripe shirt, grey shorts (boys) / green skirt (girls), green socks
  // Seniors: white shirt, green blazer optional, grey shorts/trousers (boys) / green skirt (girls)

  const s=size;
  const skin=rChoice(skinTones);
  const hair=rChoice(hairColors);
  const isFemale=rand()>0.5;
  const hasBlazor=!junior&&rand()>0.6; // seniors sometimes have green blazer

  // facing: 0=profile right, 1=profile left, 2=straight on
  const forward = facing===2;
  // For profile views, apply flip based on facing direction
  const doFlip = facing===1 ? true : (facing===0 ? false : flip);


  // Colours — matching reference sheet exactly
  const GREEN='#1a6020';       // dark green blazer/skirt/socks
  const GREEN_MID='#2a7830';   // mid green for skirt folds
  const GREEN_LIGHT='#3a9040'; // lighter green accent
  const STRIPE_GREEN='#2a8030';// green shirt stripe
  const GREY='#3c3c40';        // dark grey shorts/trousers
  const GREY_MID='#2e2e32';
  const WHITE='#f4f4f2';
  const WHITE_OFF='#e8e8e4';
  const SOCK_GREEN='#1e6828';  // green socks
  const OUTLINE='rgba(40,28,18,0.85)'; // dark brown outline colour

  ctx.save();
  ctx.translate(x,y);
  if(doFlip) ctx.scale(-1,1);

  // ── PROPORTIONS (feet at y=0, drawing upward) ──
  // Shoes:   0  to -s*0.1
  // Legs:    -s*0.1 to -s*0.62
  // Torso:   -s*0.62 to -s*1.0
  // Neck:    -s*1.0 to -s*1.08
  // Head:    centre -s*1.28, radius s*0.24

  // ── GROUND SHADOW ──
  ctx.fillStyle='rgba(0,0,0,0.1)';
  ctx.beginPath(); ctx.ellipse(0,0,s*0.3,s*0.055,0,0,Math.PI*2); ctx.fill();

  // ── SHOES — black, rounded, with sole ──
  const shoeOffL = pose===1 ? s*0.04 : 0;
  const shoeOffR = pose===1 ? -s*0.04 : 0;
  // Soles
  ctx.fillStyle='#2a2220';
  ctx.beginPath(); ctx.ellipse(-s*0.14+shoeOffL,-s*0.03,s*0.14,s*0.055,0.12,0,Math.PI*2); ctx.fill();
  ctx.beginPath(); ctx.ellipse(s*0.14+shoeOffR,-s*0.03,s*0.14,s*0.055,-0.12,0,Math.PI*2); ctx.fill();
  // Shoe upper
  ctx.fillStyle='#111';
  ctx.beginPath(); ctx.ellipse(-s*0.14+shoeOffL,-s*0.05,s*0.12,s*0.042,0.12,0,Math.PI*2); ctx.fill();
  ctx.beginPath(); ctx.ellipse(s*0.14+shoeOffR,-s*0.05,s*0.12,s*0.042,-0.12,0,Math.PI*2); ctx.fill();
  // Shoe highlight
  ctx.fillStyle='rgba(255,255,255,0.12)';
  ctx.beginPath(); ctx.ellipse(-s*0.16+shoeOffL,-s*0.06,s*0.05,s*0.02,0.12,0,Math.PI*2); ctx.fill();
  ctx.beginPath(); ctx.ellipse(s*0.12+shoeOffR,-s*0.06,s*0.05,s*0.02,-0.12,0,Math.PI*2); ctx.fill();

  // ── SOCKS — green, visible below shorts/skirt ──
  if(junior || isFemale){
    ctx.fillStyle=SOCK_GREEN;
    ctx.beginPath(); ctx.roundRect(-s*0.22,-s*0.22,s*0.16,s*0.14,s*0.04); ctx.fill();
    ctx.beginPath(); ctx.roundRect(s*0.06,-s*0.22,s*0.16,s*0.14,s*0.04); ctx.fill();
    // Sock top band
    ctx.fillStyle=GREEN_LIGHT;
    ctx.fillRect(-s*0.22,-s*0.22,s*0.16,s*0.025);
    ctx.fillRect(s*0.06,-s*0.22,s*0.16,s*0.025);
  }

  // ── LEGS / BOTTOM GARMENT ──
  if(junior && !isFemale){
    // GREY SHORTS — boys junior
    ctx.fillStyle=GREY;
    ctx.beginPath(); ctx.roundRect(-s*0.26,-s*0.58,s*0.22,s*0.38,s*0.05); ctx.fill();
    ctx.beginPath(); ctx.roundRect(s*0.04,-s*0.58,s*0.22,s*0.38,s*0.05); ctx.fill();
    ctx.fillStyle=GREY_MID; ctx.fillRect(-s*0.04,-s*0.58,s*0.08,s*0.16); // crotch seam
    // Bare legs between sock and short
    ctx.fillStyle=skin;
    ctx.fillRect(-s*0.24,-s*0.22,s*0.18,s*0.02);
    ctx.fillRect(s*0.06,-s*0.22,s*0.18,s*0.02);
    // Outline
    ctx.strokeStyle=OUTLINE; ctx.lineWidth=s*0.018;
    ctx.beginPath(); ctx.roundRect(-s*0.26,-s*0.58,s*0.22,s*0.38,s*0.05); ctx.stroke();
    ctx.beginPath(); ctx.roundRect(s*0.04,-s*0.58,s*0.22,s*0.38,s*0.05); ctx.stroke();
  } else if(!isFemale){
    // GREY TROUSERS — boys senior
    ctx.fillStyle=GREY;
    ctx.beginPath(); ctx.roundRect(-s*0.26,-s*0.62,s*0.22,s*0.6,s*0.04); ctx.fill();
    ctx.beginPath(); ctx.roundRect(s*0.04,-s*0.62,s*0.22,s*0.6,s*0.04); ctx.fill();
    ctx.fillStyle=GREY_MID; ctx.fillRect(-s*0.04,-s*0.62,s*0.08,s*0.2);
    // Trouser crease
    ctx.strokeStyle='rgba(20,20,24,0.2)'; ctx.lineWidth=s*0.015;
    ctx.beginPath(); ctx.moveTo(-s*0.15,-s*0.62); ctx.lineTo(-s*0.15,-s*0.1); ctx.stroke();
    ctx.beginPath(); ctx.moveTo(s*0.15,-s*0.62); ctx.lineTo(s*0.15,-s*0.1); ctx.stroke();
    ctx.strokeStyle=OUTLINE; ctx.lineWidth=s*0.018;
    ctx.beginPath(); ctx.roundRect(-s*0.26,-s*0.62,s*0.22,s*0.6,s*0.04); ctx.stroke();
    ctx.beginPath(); ctx.roundRect(s*0.04,-s*0.62,s*0.22,s*0.6,s*0.04); ctx.stroke();
  } else {
    // GREEN SKIRT — girls (both junior and senior)
    // Flared A-line skirt like reference
    ctx.fillStyle=GREEN;
    ctx.beginPath();
    ctx.moveTo(-s*0.28,-s*0.62); ctx.lineTo(s*0.28,-s*0.62);
    ctx.lineTo(s*0.36,-s*0.08); ctx.lineTo(-s*0.36,-s*0.08);
    ctx.closePath(); ctx.fill();
    // Skirt fold shading
    ctx.fillStyle=GREEN_MID;
    ctx.fillRect(-s*0.36,-s*0.08,s*0.72,s*0.02);
    // Pleat lines
    ctx.strokeStyle='rgba(10,40,16,0.3)'; ctx.lineWidth=s*0.018;
    [-s*0.1,0,s*0.1].forEach(px=>{
      ctx.beginPath(); ctx.moveTo(px,-s*0.62); ctx.lineTo(px*1.3,-s*0.1); ctx.stroke();
    });
    ctx.strokeStyle=OUTLINE; ctx.lineWidth=s*0.02;
    ctx.beginPath();
    ctx.moveTo(-s*0.28,-s*0.62); ctx.lineTo(s*0.28,-s*0.62);
    ctx.lineTo(s*0.36,-s*0.08); ctx.lineTo(-s*0.36,-s*0.08); ctx.closePath(); ctx.stroke();
    // Legs below skirt
    ctx.fillStyle=skin;
    ctx.fillRect(-s*0.21,-s*0.1,s*0.16,s*0.02);
    ctx.fillRect(s*0.05,-s*0.1,s*0.16,s*0.02);
  }

  // ── SHIRT / UPPER BODY ──
  if(junior){
    // WHITE SHIRT WITH GREEN CHECK PATTERN — junior uniform
    ctx.fillStyle=WHITE;
    ctx.beginPath(); ctx.roundRect(-s*0.28,-s*1.0,s*0.56,s*0.42,s*0.04); ctx.fill();
    // Check grid — vertical lines (tighter spacing for smaller checks)
    ctx.strokeStyle=STRIPE_GREEN; ctx.lineWidth=s*0.016; ctx.globalAlpha=0.55;
    for(let sx2=-s*0.24; sx2<s*0.28; sx2+=s*0.065){
      ctx.beginPath(); ctx.moveTo(sx2,-s*1.0); ctx.lineTo(sx2,-s*0.58); ctx.stroke();
    }
    // Check grid — horizontal lines
    for(let sy2=-s*1.0; sy2<-s*0.58; sy2+=s*0.065){
      ctx.beginPath(); ctx.moveTo(-s*0.28,sy2); ctx.lineTo(s*0.28,sy2); ctx.stroke();
    }
    ctx.globalAlpha=1;
    // Collar — small V
    ctx.fillStyle=WHITE_OFF;
    ctx.beginPath(); ctx.moveTo(-s*0.1,-s*1.0); ctx.lineTo(0,-s*0.88); ctx.lineTo(s*0.1,-s*1.0); ctx.fill();
    // Shirt outline
    ctx.strokeStyle=OUTLINE; ctx.lineWidth=s*0.02;
    ctx.beginPath(); ctx.roundRect(-s*0.28,-s*1.0,s*0.56,s*0.42,s*0.04); ctx.stroke();
    // Pocket
    ctx.strokeStyle=OUTLINE; ctx.lineWidth=s*0.016;
    ctx.beginPath(); ctx.roundRect(-s*0.22,-s*0.9,s*0.1,s*0.1,s*0.02); ctx.stroke();
    // School badge on pocket
    ctx.fillStyle=GREEN;
    ctx.beginPath(); ctx.roundRect(-s*0.21,-s*0.89,s*0.08,s*0.08,s*0.015); ctx.fill();
    // Arms — white with check
    ctx.fillStyle=WHITE;
    ctx.beginPath(); ctx.roundRect(-s*0.52,-s*0.98,s*0.26,s*0.32,s*0.06); ctx.fill();
    ctx.beginPath(); ctx.roundRect(s*0.28,-s*0.98,s*0.26,s*0.32,s*0.06); ctx.fill();
    // Check on arms
    ctx.strokeStyle=STRIPE_GREEN; ctx.lineWidth=s*0.016; ctx.globalAlpha=0.5;
    [-s*0.46,-s*0.4,-s*0.34,-s*0.28].forEach(ax=>{
      ctx.beginPath(); ctx.moveTo(ax,-s*0.98); ctx.lineTo(ax,-s*0.66); ctx.stroke();
    });
    [s*0.28,s*0.34,s*0.4,s*0.46].forEach(ax=>{
      ctx.beginPath(); ctx.moveTo(ax,-s*0.98); ctx.lineTo(ax,-s*0.66); ctx.stroke();
    });
    [-s*0.92,-s*0.86,-s*0.8,-s*0.74,-s*0.68].forEach(ay=>{
      ctx.beginPath(); ctx.moveTo(-s*0.52,ay); ctx.lineTo(-s*0.26,ay); ctx.stroke();
      ctx.beginPath(); ctx.moveTo(s*0.28,ay); ctx.lineTo(s*0.54,ay); ctx.stroke();
    });
    ctx.globalAlpha=1;
    ctx.strokeStyle=OUTLINE; ctx.lineWidth=s*0.018;
    ctx.beginPath(); ctx.roundRect(-s*0.52,-s*0.98,s*0.26,s*0.32,s*0.06); ctx.stroke();
    ctx.beginPath(); ctx.roundRect(s*0.28,-s*0.98,s*0.26,s*0.32,s*0.06); ctx.stroke();
  } else if(hasBlazor){
    // GREEN BLAZER — seniors (like reference senior uniform)
    ctx.fillStyle=GREEN;
    ctx.beginPath(); ctx.roundRect(-s*0.3,-s*1.02,s*0.6,s*0.44,s*0.04); ctx.fill();
    // Lapels — white shirt showing
    ctx.fillStyle=WHITE;
    ctx.beginPath(); ctx.moveTo(-s*0.12,-s*1.02); ctx.lineTo(-s*0.06,-s*0.86); ctx.lineTo(0,-s*0.9); ctx.fill();
    ctx.beginPath(); ctx.moveTo(s*0.12,-s*1.02); ctx.lineTo(s*0.06,-s*0.86); ctx.lineTo(0,-s*0.9); ctx.fill();
    // Green tie on shirt
    ctx.fillStyle=STRIPE_GREEN;
    ctx.beginPath(); ctx.moveTo(-s*0.03,-s*1.02); ctx.lineTo(s*0.03,-s*1.02); ctx.lineTo(s*0.04,-s*0.78); ctx.lineTo(0,-s*0.72); ctx.lineTo(-s*0.04,-s*0.78); ctx.closePath(); ctx.fill();
    // Blazer pocket badge
    ctx.fillStyle=GREEN_LIGHT;
    ctx.beginPath(); ctx.roundRect(-s*0.24,-s*0.9,s*0.1,s*0.1,s*0.02); ctx.fill();
    ctx.fillStyle='rgba(255,220,0,0.8)'; ctx.font=`bold ${s*0.065}px Arial`; ctx.textAlign='center';
    ctx.fillText('C',-s*0.19,-s*0.84);
    ctx.strokeStyle=OUTLINE; ctx.lineWidth=s*0.02;
    ctx.beginPath(); ctx.roundRect(-s*0.3,-s*1.02,s*0.6,s*0.44,s*0.04); ctx.stroke();
    // Blazer arms
    ctx.fillStyle=GREEN;
    ctx.beginPath(); ctx.roundRect(-s*0.54,-s*1.0,s*0.26,s*0.32,s*0.06); ctx.fill();
    ctx.beginPath(); ctx.roundRect(s*0.3,-s*1.0,s*0.26,s*0.32,s*0.06); ctx.fill();
    ctx.strokeStyle=OUTLINE; ctx.lineWidth=s*0.018;
    ctx.beginPath(); ctx.roundRect(-s*0.54,-s*1.0,s*0.26,s*0.32,s*0.06); ctx.stroke();
    ctx.beginPath(); ctx.roundRect(s*0.3,-s*1.0,s*0.26,s*0.32,s*0.06); ctx.stroke();
  } else {
    // PLAIN WHITE SHIRT — seniors without blazer
    ctx.fillStyle=WHITE;
    ctx.beginPath(); ctx.roundRect(-s*0.28,-s*1.0,s*0.56,s*0.4,s*0.04); ctx.fill();
    // Button placket
    ctx.strokeStyle='rgba(180,180,175,0.6)'; ctx.lineWidth=s*0.015;
    ctx.beginPath(); ctx.moveTo(0,-s*1.0); ctx.lineTo(0,-s*0.62); ctx.stroke();
    [s*0.72,s*0.8,s*0.88].forEach(by=>{
      ctx.fillStyle='#c0c0bc'; ctx.beginPath(); ctx.arc(0,-by,s*0.016,0,Math.PI*2); ctx.fill();
    });
    // Collar
    ctx.fillStyle=WHITE_OFF;
    ctx.beginPath(); ctx.moveTo(-s*0.12,-s*1.0); ctx.lineTo(-s*0.04,-s*0.87); ctx.lineTo(0,-s*0.91); ctx.fill();
    ctx.beginPath(); ctx.moveTo(s*0.12,-s*1.0); ctx.lineTo(s*0.04,-s*0.87); ctx.lineTo(0,-s*0.91); ctx.fill();
    ctx.strokeStyle=OUTLINE; ctx.lineWidth=s*0.02;
    ctx.beginPath(); ctx.roundRect(-s*0.28,-s*1.0,s*0.56,s*0.4,s*0.04); ctx.stroke();
    // Arms
    ctx.fillStyle=WHITE;
    ctx.beginPath(); ctx.roundRect(-s*0.52,-s*0.98,s*0.26,s*0.3,s*0.06); ctx.fill();
    ctx.beginPath(); ctx.roundRect(s*0.28,-s*0.98,s*0.26,s*0.3,s*0.06); ctx.fill();
    ctx.strokeStyle=OUTLINE; ctx.lineWidth=s*0.018;
    ctx.beginPath(); ctx.roundRect(-s*0.52,-s*0.98,s*0.26,s*0.3,s*0.06); ctx.stroke();
    ctx.beginPath(); ctx.roundRect(s*0.28,-s*0.98,s*0.26,s*0.3,s*0.06); ctx.stroke();
  }

  // ── HANDS — round, skin-coloured ──
  ctx.fillStyle=skin;
  const [lhx,lhy,rhx,rhy] = pose===1
    ? [-s*0.44,-s*0.82,  s*0.42,-s*0.64]
    : pose===2
    ? [-s*0.46,-s*0.92,  s*0.44,-s*0.7]
    : [-s*0.42,-s*0.7,   s*0.42,-s*0.7];
  ctx.beginPath(); ctx.arc(lhx,lhy,s*0.1,0,Math.PI*2); ctx.fill();
  ctx.beginPath(); ctx.arc(rhx,rhy,s*0.1,0,Math.PI*2); ctx.fill();
  ctx.strokeStyle=OUTLINE; ctx.lineWidth=s*0.016;
  ctx.beginPath(); ctx.arc(lhx,lhy,s*0.1,0,Math.PI*2); ctx.stroke();
  ctx.beginPath(); ctx.arc(rhx,rhy,s*0.1,0,Math.PI*2); ctx.stroke();

  // ── NECK ──
  ctx.fillStyle=skin;
  ctx.beginPath(); ctx.roundRect(-s*0.1,-s*1.08,s*0.2,s*0.1,s*0.04); ctx.fill();
  ctx.strokeStyle=OUTLINE; ctx.lineWidth=s*0.016;
  ctx.beginPath(); ctx.moveTo(-s*0.1,-s*1.08); ctx.lineTo(-s*0.1,-s*1.0); ctx.stroke();
  ctx.beginPath(); ctx.moveTo(s*0.1,-s*1.08); ctx.lineTo(s*0.1,-s*1.0); ctx.stroke();

  // ── HEAD — large, round ──
  // Head shadow
  ctx.fillStyle='rgba(0,0,0,0.08)';
  ctx.beginPath(); ctx.arc(s*0.02,-s*1.28,s*0.25,0,Math.PI*2); ctx.fill();
  // Main head
  ctx.fillStyle=skin;
  ctx.beginPath(); ctx.arc(0,-s*1.28,s*0.23,0,Math.PI*2); ctx.fill();
  // Head outline
  ctx.strokeStyle=OUTLINE; ctx.lineWidth=s*0.025;
  ctx.beginPath(); ctx.arc(0,-s*1.28,s*0.23,0,Math.PI*2); ctx.stroke();
  // Cheek blush
  ctx.fillStyle='rgba(255,160,130,0.22)';
  ctx.beginPath(); ctx.ellipse(-s*0.1,-s*1.2,s*0.07,s*0.05,0,0,Math.PI*2); ctx.fill();
  ctx.beginPath(); ctx.ellipse(s*0.1,-s*1.2,s*0.07,s*0.05,0,0,Math.PI*2); ctx.fill();

  // ── HAIR ──
  ctx.fillStyle=hair;
  // Full back hair behind head
  ctx.beginPath(); ctx.arc(0,-s*1.28,s*0.235,0,Math.PI*2); ctx.fill();
  // Face overlay — restore skin on front of face
  ctx.fillStyle=skin;
  ctx.beginPath(); ctx.arc(0,-s*1.28,s*0.218,0,Math.PI*2); ctx.fill();
  // Hair on top — smooth dome shape, no sharp rectangle
  ctx.fillStyle=hair;
  ctx.beginPath();
  ctx.arc(0,-s*1.28,s*0.235,-Math.PI,-0); // top arc
  ctx.fill();
  // Side hair blending into face naturally
  ctx.beginPath(); ctx.ellipse(-s*0.2,-s*1.26,s*0.05,s*0.12,-0.1,0,Math.PI*2); ctx.fill();
  ctx.beginPath(); ctx.ellipse(s*0.2,-s*1.26,s*0.05,s*0.12,0.1,0,Math.PI*2); ctx.fill();

  // Male: add small hair texture lines
  if(!isFemale){
    ctx.strokeStyle=hair==='#111'||hair==='#222'?'#333':hair;
    ctx.lineWidth=s*0.012; ctx.lineCap='round';
    [-s*0.1,-s*0.04,s*0.04,s*0.1].forEach(hx=>{
      ctx.beginPath(); ctx.moveTo(hx,-s*1.46); ctx.lineTo(hx,-s*1.34); ctx.stroke();
    });
  }

  // Female hair variations
  if(isFemale){
    const hairStyle = Math.floor(rand()*3); // 0=ponytail, 1=long, 2=short bob
    if(hairStyle===0){
      // Ponytail — cleaner shape
      ctx.fillStyle=hair;
      ctx.beginPath();
      ctx.ellipse(s*0.22,-s*1.16,s*0.065,s*0.2,0.45,0,Math.PI*2); ctx.fill();
      ctx.strokeStyle=OUTLINE; ctx.lineWidth=s*0.018;
      ctx.beginPath();
      ctx.ellipse(s*0.22,-s*1.16,s*0.065,s*0.2,0.45,0,Math.PI*2); ctx.stroke();
      // Hair tie
      ctx.fillStyle=rChoice(['#cc1010','#d4a000','#1a6020','#cc44aa']);
      ctx.beginPath(); ctx.arc(s*0.25,-s*1.09,s*0.038,0,Math.PI*2); ctx.fill();
    } else if(hairStyle===1){
      // Long hair — two smooth side curtains
      ctx.fillStyle=hair;
      ctx.beginPath(); ctx.ellipse(-s*0.22,-s*1.12,s*0.075,s*0.2,0.12,0,Math.PI*2); ctx.fill();
      ctx.beginPath(); ctx.ellipse(s*0.22,-s*1.12,s*0.075,s*0.2,-0.12,0,Math.PI*2); ctx.fill();
      ctx.strokeStyle=OUTLINE; ctx.lineWidth=s*0.016;
      ctx.beginPath(); ctx.ellipse(-s*0.22,-s*1.12,s*0.075,s*0.2,0.12,0,Math.PI*2); ctx.stroke();
      ctx.beginPath(); ctx.ellipse(s*0.22,-s*1.12,s*0.075,s*0.2,-0.12,0,Math.PI*2); ctx.stroke();
    } else {
      // Short bob — slight extension below ear line on both sides
      ctx.fillStyle=hair;
      ctx.beginPath(); ctx.ellipse(-s*0.2,-s*1.22,s*0.06,s*0.1,0.05,0,Math.PI*2); ctx.fill();
      ctx.beginPath(); ctx.ellipse(s*0.2,-s*1.22,s*0.06,s*0.1,-0.05,0,Math.PI*2); ctx.fill();
    }
  }
  // Subtle hair highlight
  ctx.fillStyle='rgba(255,255,255,0.12)';
  ctx.beginPath(); ctx.ellipse(-s*0.06,-s*1.43,s*0.08,s*0.05,-0.2,0,Math.PI*2); ctx.fill();

  // ── EYES — small dots like simple cartoon style ──
  ctx.fillStyle='#0a0808';
  ctx.beginPath(); ctx.arc(-s*0.09,-s*1.28,s*0.028,0,Math.PI*2); ctx.fill();
  ctx.beginPath(); ctx.arc(s*0.09,-s*1.28,s*0.028,0,Math.PI*2); ctx.fill();
  // Tiny shine dot
  ctx.fillStyle='rgba(255,255,255,0.9)';
  ctx.beginPath(); ctx.arc(-s*0.082,-s*1.293,s*0.01,0,Math.PI*2); ctx.fill();
  ctx.beginPath(); ctx.arc(s*0.098,-s*1.293,s*0.01,0,Math.PI*2); ctx.fill();
  // Eyebrows — thin, arched
  const brow=hair==='#d4a030'||hair==='#c8a050'?'#8a6020':hair;
  ctx.strokeStyle=brow; ctx.lineWidth=s*0.022; ctx.lineCap='round';
  ctx.beginPath(); ctx.moveTo(-s*0.14,-s*1.36); ctx.quadraticCurveTo(-s*0.09,-s*1.4,-s*0.04,-s*1.36); ctx.stroke();
  ctx.beginPath(); ctx.moveTo(s*0.04,-s*1.36); ctx.quadraticCurveTo(s*0.09,-s*1.4,s*0.14,-s*1.36); ctx.stroke();

  // ── NOSE — tiny dot ──
  ctx.fillStyle='rgba(160,80,55,0.35)';
  ctx.beginPath(); ctx.arc(0,-s*1.2,s*0.022,0,Math.PI*2); ctx.fill();

  // ── MOUTH — wide smile with teeth showing ──
  // Smile arc
  ctx.strokeStyle=OUTLINE; ctx.lineWidth=s*0.025; ctx.lineCap='round';
  ctx.beginPath(); ctx.arc(0,-s*1.14,s*0.08,0.12,Math.PI-0.12); ctx.stroke();
  // Teeth hint
  ctx.fillStyle='rgba(255,255,255,0.7)';
  ctx.beginPath(); ctx.arc(0,-s*1.12,s*0.055,0.2,Math.PI-0.2); ctx.fill();
  // Rosy cheeks (dot style like reference)
  ctx.fillStyle='rgba(240,130,100,0.3)';
  ctx.beginPath(); ctx.arc(-s*0.14,-s*1.16,s*0.05,0,Math.PI*2); ctx.fill();
  ctx.beginPath(); ctx.arc(s*0.14,-s*1.16,s*0.05,0,Math.PI*2); ctx.fill();

  // ── FORWARD-FACING OVERRIDES ──
  if(forward){
    // Legs — symmetrical, both visible
    if(junior && !isFemale){
      ctx.fillStyle=GREY;
      ctx.beginPath(); ctx.roundRect(-s*0.22,-s*0.58,s*0.18,s*0.38,s*0.05); ctx.fill();
      ctx.beginPath(); ctx.roundRect(s*0.04,-s*0.58,s*0.18,s*0.38,s*0.05); ctx.fill();
      ctx.strokeStyle=OUTLINE; ctx.lineWidth=s*0.018;
      ctx.beginPath(); ctx.roundRect(-s*0.22,-s*0.58,s*0.18,s*0.38,s*0.05); ctx.stroke();
      ctx.beginPath(); ctx.roundRect(s*0.04,-s*0.58,s*0.18,s*0.38,s*0.05); ctx.stroke();
      ctx.fillStyle=skin; ctx.fillRect(-s*0.2,-s*0.22,s*0.14,s*0.02); ctx.fillRect(s*0.06,-s*0.22,s*0.14,s*0.02);
    } else if(!isFemale){
      ctx.fillStyle=GREY;
      ctx.beginPath(); ctx.roundRect(-s*0.22,-s*0.62,s*0.18,s*0.6,s*0.04); ctx.fill();
      ctx.beginPath(); ctx.roundRect(s*0.04,-s*0.62,s*0.18,s*0.6,s*0.04); ctx.fill();
      ctx.strokeStyle=OUTLINE; ctx.lineWidth=s*0.018;
      ctx.beginPath(); ctx.roundRect(-s*0.22,-s*0.62,s*0.18,s*0.6,s*0.04); ctx.stroke();
      ctx.beginPath(); ctx.roundRect(s*0.04,-s*0.62,s*0.18,s*0.6,s*0.04); ctx.stroke();
    }
    // Both arms at sides
    ctx.fillStyle=skin;
    ctx.beginPath(); ctx.arc(-s*0.38,-s*0.72,s*0.1,0,Math.PI*2); ctx.fill();
    ctx.beginPath(); ctx.arc(s*0.38,-s*0.72,s*0.1,0,Math.PI*2); ctx.fill();
    ctx.strokeStyle=OUTLINE; ctx.lineWidth=s*0.016;
    ctx.beginPath(); ctx.arc(-s*0.38,-s*0.72,s*0.1,0,Math.PI*2); ctx.stroke();
    ctx.beginPath(); ctx.arc(s*0.38,-s*0.72,s*0.1,0,Math.PI*2); ctx.stroke();
    // Both eyes visible (forward face)
    ctx.fillStyle='#0a0808';
    ctx.beginPath(); ctx.arc(-s*0.09,-s*1.28,s*0.028,0,Math.PI*2); ctx.fill();
    ctx.beginPath(); ctx.arc(s*0.09,-s*1.28,s*0.028,0,Math.PI*2); ctx.fill();
    ctx.fillStyle='rgba(255,255,255,0.9)';
    ctx.beginPath(); ctx.arc(-s*0.082,-s*1.293,s*0.01,0,Math.PI*2); ctx.fill();
    ctx.beginPath(); ctx.arc(s*0.098,-s*1.293,s*0.01,0,Math.PI*2); ctx.fill();
  }
  ctx.restore();
}

// ── HIDDEN CHARACTER DRAWERS ──

function drawChicken(x,y,s){
  ctx.save();ctx.translate(x,y);
  // shadow
  ctx.fillStyle='rgba(0,0,0,0.2)';
  ctx.beginPath();ctx.ellipse(0,s*0.52,s*0.35,s*0.1,0,0,Math.PI*2);ctx.fill();
  // body
  ctx.fillStyle='#f5e8c8';
  ctx.beginPath();ctx.ellipse(0,s*0.2,s*0.32,s*0.28,0,0,Math.PI*2);ctx.fill();
  // wing
  ctx.fillStyle='#e8d8a8';
  ctx.beginPath();ctx.ellipse(-s*0.1,s*0.2,s*0.18,s*0.14,-0.3,0,Math.PI*2);ctx.fill();
  // tail
  ctx.fillStyle='#d4c090';
  ctx.beginPath();ctx.moveTo(-s*0.3,s*0.1);ctx.bezierCurveTo(-s*0.55,0,-s*0.6,s*0.3,-s*0.35,s*0.3);ctx.fill();
  // legs
  ctx.strokeStyle='#e8a020';ctx.lineWidth=s*0.07;ctx.lineCap='round';
  ctx.beginPath();ctx.moveTo(-s*0.1,s*0.44);ctx.lineTo(-s*0.1,s*0.58);ctx.stroke();
  ctx.beginPath();ctx.moveTo(s*0.1,s*0.44);ctx.lineTo(s*0.1,s*0.58);ctx.stroke();
  // feet
  ctx.strokeStyle='#e8a020';ctx.lineWidth=s*0.05;
  ctx.beginPath();ctx.moveTo(-s*0.1,s*0.58);ctx.lineTo(-s*0.22,s*0.62);ctx.stroke();
  ctx.beginPath();ctx.moveTo(-s*0.1,s*0.58);ctx.lineTo(-s*0.04,s*0.64);ctx.stroke();
  ctx.beginPath();ctx.moveTo(s*0.1,s*0.58);ctx.lineTo(s*0.22,s*0.62);ctx.stroke();
  ctx.beginPath();ctx.moveTo(s*0.1,s*0.58);ctx.lineTo(s*0.16,s*0.64);ctx.stroke();
  // head
  ctx.fillStyle='#f5e8c8';
  ctx.beginPath();ctx.arc(s*0.2,-s*0.08,s*0.22,0,Math.PI*2);ctx.fill();
  // comb
  ctx.fillStyle='#cc1a1a';
  ctx.beginPath();ctx.moveTo(s*0.12,-s*0.28);ctx.bezierCurveTo(s*0.08,-s*0.46,s*0.18,-s*0.5,s*0.2,-s*0.34);ctx.fill();
  ctx.beginPath();ctx.moveTo(s*0.2,-s*0.28);ctx.bezierCurveTo(s*0.18,-s*0.5,s*0.28,-s*0.5,s*0.26,-s*0.3);ctx.fill();
  ctx.beginPath();ctx.moveTo(s*0.26,-s*0.26);ctx.bezierCurveTo(s*0.25,-s*0.44,s*0.35,-s*0.44,s*0.32,-s*0.26);ctx.fill();
  // wattle
  ctx.fillStyle='#cc1a1a';
  ctx.beginPath();ctx.ellipse(s*0.3,s*0.02,s*0.06,s*0.1,0.2,0,Math.PI*2);ctx.fill();
  // beak
  ctx.fillStyle='#f0b820';
  ctx.beginPath();ctx.moveTo(s*0.38,-s*0.1);ctx.lineTo(s*0.56,-s*0.08);ctx.lineTo(s*0.38,-s*0.02);ctx.fill();
  // eye
  ctx.fillStyle='#1a0a00';
