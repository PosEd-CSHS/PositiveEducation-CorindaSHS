  [s*0.08,s*0.16,s*0.24].forEach(bx=>{ctx.beginPath();ctx.arc(bx,s*1.0,s*0.02,0,Math.PI*2);ctx.fill();});
  // socks — white with coloured band
  ctx.fillStyle='#f0f0ee';ctx.fillRect(-s*0.26,s*0.78,s*0.22,s*0.14);ctx.fillRect(s*0.06,s*0.78,s*0.22,s*0.14);
  ctx.fillStyle=kitCol;ctx.fillRect(-s*0.26,s*0.78,s*0.22,s*0.04);ctx.fillRect(s*0.06,s*0.78,s*0.22,s*0.04);
  // shin pads (slight bump under socks)
  ctx.fillStyle='rgba(255,255,255,0.3)';ctx.fillRect(-s*0.24,s*0.66,s*0.18,s*0.14);ctx.fillRect(s*0.08,s*0.66,s*0.18,s*0.14);
  // shorts
  ctx.fillStyle=kitCol;ctx.beginPath();ctx.roundRect(-s*0.28,s*0.46,s*0.24,s*0.36,s*0.03);ctx.fill();
