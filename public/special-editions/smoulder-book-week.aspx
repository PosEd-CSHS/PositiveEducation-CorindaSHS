function drawTeacher(x,y,s,gender){
  // gender: 0=male, 1=female
  ctx.save();ctx.translate(x,y);
  const skin=rChoice(['#f5d0a0','#e8b87a','#c8895a','#a0623a']);
  ctx.fillStyle='rgba(0,0,0,0.18)';
  ctx.beginPath();ctx.ellipse(0,s*1.05,s*0.38,s*0.1,0,0,Math.PI*2);ctx.fill();
  // shoes
  ctx.fillStyle='#1a1408';
  ctx.fillRect(-s*0.28,s*0.92,s*0.24,s*0.1);
  ctx.fillRect(s*0.05,s*0.92,s*0.24,s*0.1);
  // trousers/skirt
  if(gender===0){
    ctx.fillStyle='#2a3560';
    ctx.fillRect(-s*0.26,s*0.52,s*0.22,s*0.44);
    ctx.fillRect(s*0.06,s*0.52,s*0.22,s*0.44);
  } else {
    ctx.fillStyle='#1a1a4a';
    ctx.beginPath();ctx.moveTo(-s*0.3,s*0.5);ctx.lineTo(s*0.3,s*0.5);ctx.lineTo(s*0.36,s*0.92);ctx.lineTo(-s*0.36,s*0.92);ctx.fill();
  }
  // jacket/blouse
  const jcol=gender===0?'#1a3560':'#6a1a40';
  ctx.fillStyle=jcol;
  ctx.fillRect(-s*0.32,s*0.1,s*0.64,s*0.44);
  // shirt white underneath
  ctx.fillStyle='#f0f0f0';
  ctx.fillRect(-s*0.12,s*0.1,s*0.24,s*0.4);
  // tie/lanyard
  ctx.fillStyle=gender===0?'#cc2020':'#f2b400';
  ctx.beginPath();ctx.moveTo(-s*0.04,s*0.12);ctx.lineTo(s*0.04,s*0.12);ctx.lineTo(s*0.06,s*0.38);ctx.lineTo(0,s*0.48);ctx.lineTo(-s*0.06,s*0.38);ctx.closePath();ctx.fill();
  // arms
  ctx.fillStyle=jcol;
  ctx.fillRect(-s*0.54,s*0.12,s*0.24,s*0.34);
  ctx.fillRect(s*0.3,s*0.12,s*0.24,s*0.34);
  // hands
  ctx.fillStyle=skin;
  ctx.beginPath();ctx.arc(-s*0.42,s*0.48,s*0.12,0,Math.PI*2);ctx.fill();
  // clipboard in one hand
  ctx.fillStyle='#d4a050';
  ctx.fillRect(s*0.28,s*0.22,s*0.22,s*0.3);
  ctx.fillStyle='#fff';ctx.fillRect(s*0.3,s*0.25,s*0.18,s*0.23);
  ctx.fillStyle='#888';ctx.fillRect(s*0.32,s*0.28,s*0.14,s*0.02);
  ctx.fillRect(s*0.32,s*0.32,s*0.14,s*0.02);
  ctx.fillRect(s*0.32,s*0.36,s*0.1,s*0.02);
  ctx.fillStyle=skin;ctx.beginPath();ctx.arc(s*0.38,s*0.54,s*0.12,0,Math.PI*2);ctx.fill();
  // neck
  ctx.fillStyle=skin;
  ctx.fillRect(-s*0.12,-s*0.08,s*0.24,s*0.2);
  // head
  ctx.fillStyle=skin;
  ctx.beginPath();ctx.ellipse(0,-s*0.3,s*0.24,s*0.28,0,0,Math.PI*2);ctx.fill();
  // hair
  const hc=gender===0?rChoice(['#1a0a00','#3a2010','#888','#6a6a6a']):rChoice(['#1a0a00','#8a4020','#c8a050','#e0e0e0']);
  ctx.fillStyle=hc;
  if(gender===0){
    ctx.beginPath();ctx.ellipse(0,-s*0.5,s*0.25,s*0.14,0,0,Math.PI*2);ctx.fill();
    ctx.fillRect(-s*0.25,-s*0.52,s*0.5,s*0.1);
  } else {
    ctx.beginPath();ctx.ellipse(0,-s*0.52,s*0.26,s*0.16,0,0,Math.PI*2);ctx.fill();
    ctx.fillRect(-s*0.26,-s*0.52,s*0.52,s*0.14);
    ctx.beginPath();ctx.ellipse(-s*0.22,-s*0.3,s*0.08,s*0.2,0.2,0,Math.PI*2);ctx.fill();
    ctx.beginPath();ctx.ellipse(s*0.22,-s*0.3,s*0.08,s*0.2,-0.2,0,Math.PI*2);ctx.fill();
  }
  // glasses (teachers wear glasses)
  ctx.strokeStyle='#333';ctx.lineWidth=s*0.04;
  ctx.beginPath();ctx.arc(-s*0.1,-s*0.3,s*0.08,0,Math.PI*2);ctx.stroke();
  ctx.beginPath();ctx.arc(s*0.1,-s*0.3,s*0.08,0,Math.PI*2);ctx.stroke();
  ctx.beginPath();ctx.moveTo(-s*0.02,-s*0.3);ctx.lineTo(s*0.02,-s*0.3);ctx.stroke();
  ctx.beginPath();ctx.moveTo(-s*0.18,-s*0.3);ctx.lineTo(-s*0.22,-s*0.3);ctx.stroke();
  ctx.beginPath();ctx.moveTo(s*0.18,-s*0.3);ctx.lineTo(s*0.22,-s*0.3);ctx.stroke();
  // eyes behind glasses
  ctx.fillStyle='#1a0a00';
  ctx.beginPath();ctx.arc(-s*0.1,-s*0.3,s*0.038,0,Math.PI*2);ctx.fill();
  ctx.beginPath();ctx.arc(s*0.1,-s*0.3,s*0.038,0,Math.PI*2);ctx.fill();
  // mouth
  ctx.strokeStyle='#8a5030';ctx.lineWidth=s*0.03;
  ctx.beginPath();ctx.arc(0,-s*0.16,s*0.06,0.2,Math.PI-0.2);ctx.stroke();
  ctx.restore();
}

