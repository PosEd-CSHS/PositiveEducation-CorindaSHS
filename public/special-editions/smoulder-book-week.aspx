  // Small secondary shine
  ctx.fillStyle='rgba(255,255,255,0.3)';
  ctx.beginPath();ctx.arc(-s*0.08,-s*0.21,s*0.02,0,Math.PI*2);ctx.fill();
  ctx.beginPath();ctx.arc(s*0.12,-s*0.21,s*0.02,0,Math.PI*2);ctx.fill();
  // Goggle outline for crispness
  ctx.strokeStyle='#8a7000';ctx.lineWidth=s*0.02;
  ctx.beginPath();ctx.arc(-s*0.1,-s*0.24,s*0.13,0,Math.PI*2);ctx.stroke();
  ctx.beginPath();ctx.arc(s*0.1,-s*0.24,s*0.13,0,Math.PI*2);ctx.stroke();
  // mouth — focused expression
  ctx.strokeStyle='#8a5030';ctx.lineWidth=s*0.025;
  ctx.beginPath();ctx.moveTo(-s*0.06,-s*0.08);ctx.lineTo(s*0.06,-s*0.08);ctx.stroke();
  ctx.restore();
}

