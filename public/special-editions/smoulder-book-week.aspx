function drawHorse(x,y,s){
  // Yarraman House — clean STANDING side-profile black horse, facing right.
  // Redesigned for a clearer silhouette. All four hooves at y=0.
  ctx.save(); ctx.translate(x,y);

  const BLACK='#11100e';
  const MANE='#080706';

  // Ground shadow
  ctx.fillStyle='rgba(0,0,0,0.18)';
  ctx.beginPath(); ctx.ellipse(0,s*0.02,s*0.52,s*0.06,0,0,Math.PI*2); ctx.fill();

  // ── LEGS ── two pairs, tapered, far pair inset & drawn first ──
  function leg(cx){
    const topW=s*0.075, botW=s*0.055;
    ctx.fillStyle=BLACK;
    ctx.beginPath();
    ctx.moveTo(cx-topW,-s*0.52);
    ctx.lineTo(cx+topW,-s*0.52);
    ctx.lineTo(cx+botW,-s*0.02);
    ctx.lineTo(cx-botW,-s*0.02);
    ctx.closePath(); ctx.fill();
    // hoof
    ctx.fillStyle='#040303';
    ctx.fillRect(cx-botW-s*0.01,-s*0.06,botW*2+s*0.03,s*0.06);
  }
  leg(-s*0.16);   // far hind
  leg( s*0.30);   // far front
  leg(-s*0.26);   // near hind
  leg( s*0.40);   // near front

  // ── TAIL — flows down from rump, tapered ──
  ctx.fillStyle=BLACK;
  ctx.beginPath();
  ctx.moveTo(-s*0.44,-s*0.64);
  ctx.bezierCurveTo(-s*0.60,-s*0.50,-s*0.58,-s*0.20,-s*0.48,-s*0.02);
  ctx.lineTo(-s*0.40,-s*0.04);
  ctx.bezierCurveTo(-s*0.40,-s*0.36,-s*0.38,-s*0.52,-s*0.34,-s*0.62);
  ctx.closePath(); ctx.fill();

  // ── BODY — barrel, slightly tilted ──
  ctx.fillStyle=BLACK;
  ctx.beginPath();
  ctx.ellipse(0,-s*0.66,s*0.42,s*0.20,-0.06,0,Math.PI*2); ctx.fill();
  // rump + chest rounding
  ctx.beginPath(); ctx.ellipse(-s*0.34,-s*0.66,s*0.16,s*0.19,0,0,Math.PI*2); ctx.fill();
  ctx.beginPath(); ctx.ellipse(s*0.34,-s*0.62,s*0.17,s*0.20,0,0,Math.PI*2); ctx.fill();

  // ── NECK — thick, arched, wide base into the shoulder ──
  ctx.beginPath();
  ctx.moveTo(s*0.20,-s*0.80);
  ctx.bezierCurveTo(s*0.34,-s*0.98,s*0.48,-s*1.08,s*0.60,-s*1.16);
  ctx.bezierCurveTo(s*0.68,-s*1.08,s*0.62,-s*0.96,s*0.54,-s*0.90);
  ctx.bezierCurveTo(s*0.48,-s*0.82,s*0.44,-s*0.74,s*0.40,-s*0.66);
  ctx.lineTo(s*0.20,-s*0.66);
  ctx.closePath(); ctx.fill();

  // ── HEAD — muzzle angled down-right ──
  ctx.beginPath();
  ctx.moveTo(s*0.56,-s*1.16);
  ctx.bezierCurveTo(s*0.66,-s*1.20,s*0.80,-s*1.16,s*0.84,-s*1.06);
  ctx.bezierCurveTo(s*0.86,-s*1.00,s*0.80,-s*0.96,s*0.74,-s*0.96);
  ctx.bezierCurveTo(s*0.66,-s*0.97,s*0.58,-s*1.02,s*0.54,-s*1.08);
  ctx.closePath(); ctx.fill();

  // ── EARS ──
  ctx.beginPath();
  ctx.moveTo(s*0.58,-s*1.18); ctx.lineTo(s*0.55,-s*1.32); ctx.lineTo(s*0.64,-s*1.20); ctx.closePath(); ctx.fill();
  ctx.beginPath();
  ctx.moveTo(s*0.64,-s*1.19); ctx.lineTo(s*0.64,-s*1.31); ctx.lineTo(s*0.71,-s*1.18); ctx.closePath(); ctx.fill();

  // ── MANE — jagged along back of neck ──
  ctx.fillStyle=MANE;
  ctx.beginPath();
  ctx.moveTo(s*0.20,-s*0.80);
  ctx.bezierCurveTo(s*0.34,-s*0.98,s*0.48,-s*1.08,s*0.60,-s*1.15);
  ctx.lineTo(s*0.54,-s*1.16);
  ctx.lineTo(s*0.50,-s*1.04);
  ctx.lineTo(s*0.44,-s*1.00);
  ctx.lineTo(s*0.40,-s*0.90);
  ctx.lineTo(s*0.32,-s*0.82);
  ctx.lineTo(s*0.26,-s*0.76);
  ctx.closePath(); ctx.fill();

  // ── Sheen on barrel ──
  ctx.fillStyle='rgba(60,52,42,0.40)';
  ctx.beginPath(); ctx.ellipse(s*0.02,-s*0.66,s*0.22,s*0.08,0,0,Math.PI*2); ctx.fill();

  // ── Eye + nostril ──
  ctx.fillStyle='rgba(255,255,255,0.82)';
  ctx.beginPath(); ctx.arc(s*0.66,-s*1.10,s*0.022,0,Math.PI*2); ctx.fill();
  ctx.fillStyle='rgba(40,40,40,1)';
  ctx.beginPath(); ctx.arc(s*0.80,-s*1.02,s*0.018,0,Math.PI*2); ctx.fill();

  ctx.restore();
}

function drawCow(x,y,s){
