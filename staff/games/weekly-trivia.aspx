function cshsAbsWeek(){
  try{
    var terms=window.CSHS_SITE_CONFIG.terms;
    var pd=function(s){var a=s.split('-');return new Date(+a[0],+a[1]-1,+a[2]);};
    var monday=function(d){var x=new Date(d);x.setDate(x.getDate()-((x.getDay()+6)%7));x.setHours(0,0,0,0);return x;};
    var today=new Date(); today.setHours(0,0,0,0);
    var abs=0, current=0;
    for(var i=0;i<terms.length;i++){
      var end=pd(terms[i].end), m=monday(pd(terms[i].start));
      while(m<=end){ abs++; if(m<=today){ current=abs; } m=new Date(m); m.setDate(m.getDate()+7); }
    }
    return current;
  }catch(e){ return 0; }
}

const STAGE_LABELS = ["This week's focus","Crack the Code","What's this logo?","General knowledge","General knowledge","General knowledge","General knowledge","General knowledge","General knowledge","On the calendar"];
const CALENDAR_STAGE = STAGE_LABELS.length - 1;
let round = null, stage = 0, score = 0, answered = false;

function currentWeekRound(){
  const abs = cshsAbsWeek();
  const idx = (abs >= 1 && abs <= ROUNDS.length) ? abs - 1 : 0;
  return ROUNDS[idx];
}

function stageData(){
  if (stage === 0) return {kind:'text', ...round.virtueQ};
  if (stage === 1) return {kind:'typed', clue: round.rebus.clue, accepted: round.rebus.accepted, answer: round.rebus.answer};
  if (stage === 2) return {kind:'logo', svg: LOGO_SVGS[round.logoIdx], choices: logoChoices(), a: logoAnswerIdx};
  if (stage >= 3 && stage <= 8) return {kind:'text', ...round.gk[stage - 3]};
  if (stage === CALENDAR_STAGE) return {kind:'text', ...round.calendar};
  return null;
}

let logoAnswerIdx = 0;
function logoChoices(){
  // 3 distractor logo names, deterministic per week+stage
  const names = LOGO_SVGS_NAMES;
  const correct = round.logo.name;
  const others = names.filter(n => n !== correct);
  const seed = round.week * 13 + 7;
  const s = seededShuffle(others, seed).slice(0,3);
  const all = seededShuffle([correct, ...s], seed + 1);
  logoAnswerIdx = all.indexOf(correct);
  return all;
}
function seededShuffle(arr, seed){
  const a=[...arr]; let s=seed;
  for(let i=a.length-1;i>0;i--){ s=(s*9301+49297)%233280; const j=Math.floor((s/233280)*(i+1)); [a[i],a[j]]=[a[j],a[i]]; }
  return a;
}
function norm(s){ return String(s||'').toLowerCase().replace(/[^a-z0-9]/g,''); }

