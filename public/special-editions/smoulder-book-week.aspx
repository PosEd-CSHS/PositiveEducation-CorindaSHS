  ctx.fillStyle='#b8ccd6';ctx.fillRect(-s*0.2,-s*0.96,s*0.4,s*0.08);
  // bubbles
  ctx.fillStyle='rgba(255,255,255,0.6)';ctx.beginPath();ctx.arc(-s*0.05,-s*0.32,s*0.03,0,Math.PI*2);ctx.arc(s*0.07,-s*0.4,s*0.022,0,Math.PI*2);ctx.fill();ctx.restore();}

function drawBalloons(x,y,s){ctx.save();ctx.translate(x,y);
