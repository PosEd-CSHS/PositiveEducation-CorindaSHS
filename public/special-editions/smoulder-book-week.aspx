function drawBackground(){
  // Pixel-precise recreation of flat-design illustration (src: 1080x576)
  // Canvas: 3200x1600. We draw in source coords then use transform to scale+position.
  // Source building base y=440, source image height=576.
  // We map: src_x -> canvas_x via cx(), src_y -> canvas_y via cy()
  // Source grass base ~y=482. Canvas ground (crowd feet) = GND=360.
  // Scale to fit full canvas width: scX = 3200/1080
  // Vertical: anchor building base (src y=440) to canvas GND-8=352, scale same as horiz for proportion

  const scX = 3200 / 1080;          // horizontal: fill full canvas width
  const scY = 308 / 225;            // vertical: fit building (src y=215–440) into canvas y=52–360
  const offY = 360 - 440 * scY;    // anchor src y=440 to canvas GND=360

  function cx(x){ return x * scX; }
  function cy(y){ return y * scY + offY; }
  function cw(w){ return w * scX; }
  function ch(h){ return h * scY; }
  function rect(x,y,w,h){ ctx.fillRect(cx(x),cy(y),cw(w),ch(h)); }
  function win(x1,y1,x2,y2){
    rect(x1,y1,x2-x1,y2-y1);
    // glass tint
    ctx.fillStyle='rgba(100,150,195,0.35)';
    ctx.fillRect(cx(x1)+2,cy(y1)+2,cw(x2-x1)-4,ch(y2-y1)-4);
    // reflection
    ctx.fillStyle='rgba(255,255,255,0.12)';
    ctx.fillRect(cx(x1)+3,cy(y1)+3,cw(x2-x1)*0.38,ch(y2-y1)*0.32);
    // mullion if wide enough
    if(cw(x2-x1)>30){
      ctx.fillStyle='#1e2428';
      ctx.fillRect(cx(x1)+cw(x2-x1)/2-1,cy(y1)+2,2,ch(y2-y1)-4);
    }
  }

  // ── SKY ──
  ctx.fillStyle='#2868c0';
  ctx.fillRect(0,0,W,cy(440));

  // ── LEFT WING (src x=108–484, y=215–440) ──
  ctx.fillStyle='#f0eeea'; rect(108,222,376,218);  // wall face
  // Parapet cap
  ctx.fillStyle='#e0dedc'; rect(106,215,380,10);
  ctx.fillStyle='#c8c6c2'; rect(106,215,380,4);
  ctx.fillStyle='rgba(0,0,0,0.07)'; rect(108,225,376,8);
  // Floor bands
  ctx.fillStyle='rgba(0,0,0,0.07)'; rect(108,302,376,5);
  ctx.fillStyle='rgba(255,255,255,0.45)'; rect(108,302,376,1.5);
  ctx.fillStyle='rgba(0,0,0,0.07)'; rect(108,382,376,4);
  ctx.fillStyle='rgba(255,255,255,0.45)'; rect(108,382,376,1.5);

  // Left wing windows - top floor
  ctx.fillStyle='#1e2428';
  win(118,232,154,270); win(162,232,198,270);
  win(210,232,246,270); win(254,232,290,270);
  win(302,232,338,270); win(346,232,382,270);
  win(394,232,430,270); win(440,232,480,270);
  // Left wing windows - mid floor
  win(118,312,154,350); win(162,312,198,350);
  win(210,312,246,350); win(254,312,290,350);
  win(302,312,338,350); win(346,312,382,350);
  win(394,312,430,350);

  // ── BRICK SECTION (src x=108–308, y=388–440) ──
  // Draw brick over lower-left portion of left wing
  const brickColors = ['#c04a28','#b83e22','#cc5030','#b44228'];
  const bY=388, bH=52, bX=108, bW=200;
  for(let row=0;row<5;row++){
    const rowH=bH/5;
    const offset=row%2===0?0:14;
    for(let col=-1;col<16;col++){
      const bx=bX+col*28+offset, by=bY+row*rowH;
      const bw2=26, bh2=rowH-1;
      if(cx(bx+bw2)>cx(bX) && cx(bx)<cx(bX+bW)){
        const clipX=Math.max(cx(bx),cx(bX));
        const clipW=Math.min(cx(bx+bw2),cx(bX+bW))-clipX;
        ctx.fillStyle=brickColors[row%4];
        ctx.fillRect(clipX,cy(by),clipW,ch(bh2));
        ctx.strokeStyle='rgba(200,155,135,0.3)'; ctx.lineWidth=0.5;
        ctx.strokeRect(clipX,cy(by),clipW,ch(bh2));
      }
    }
  }
  // Brick section windows
  ctx.fillStyle='#1e2428';
  [[116,400,144,426],[152,400,180,426],[196,400,224,426],[232,400,260,426]].forEach(([x1,y1,x2,y2])=>{
    win(x1,y1,x2,y2);
  });

  // ── CENTRE RECESSED SECTION (src x=484–618, y=240–440) ──
  ctx.fillStyle='#e4e2de'; rect(484,240,134,200);
  ctx.fillStyle='#d8d6d2'; rect(484,240,134,4); // subtle darker top
  ctx.fillStyle='#dcdad6'; rect(484,215,134,10); // parapet
  ctx.fillStyle='#c4c2be'; rect(484,215,134,4);
  ctx.fillStyle='rgba(0,0,0,0.06)'; rect(484,248,134,7);

  // Centre section floor bands
  ctx.fillStyle='rgba(0,0,0,0.06)'; rect(484,316,134,5);
  ctx.fillStyle='rgba(0,0,0,0.06)'; rect(484,390,134,4);

  // Dark covered walkway ground floor (src x=400–618, y=392–440)
  ctx.fillStyle='#2c3038'; rect(400,392,218,48);
  // Walkway pillars
  ctx.fillStyle='#3a4048';
  [408,436,464,492,520,548,576,604].forEach(px=>{
    ctx.fillRect(cx(px),cy(392),cw(6),ch(48));
  });
  ctx.fillStyle='rgba(255,255,255,0.06)';
  [408,436,464,492,520,548,576,604].forEach(px=>{
    ctx.fillRect(cx(px),cy(392),cw(2),ch(48));
  });
  // Also dark walkway extends under left wing from x=308–400
  ctx.fillStyle='#2c3038'; rect(308,392,92,48);

  // Centre windows
  ctx.fillStyle='#1e2428';
  win(496,252,534,288); win(542,252,580,288);
  win(496,334,534,368); win(542,334,580,368);

  // ── RIGHT MAIN WING (src x=618–860, y=215–440) ──
  ctx.fillStyle='#f0eeea'; rect(618,222,242,218);
  ctx.fillStyle='#e0dedc'; rect(616,215,246,10);
  ctx.fillStyle='#c8c6c2'; rect(616,215,246,4);
  ctx.fillStyle='rgba(0,0,0,0.07)'; rect(618,225,242,8);
  ctx.fillStyle='rgba(0,0,0,0.07)'; rect(618,302,242,5);
  ctx.fillStyle='rgba(255,255,255,0.45)'; rect(618,302,242,1.5);
  ctx.fillStyle='rgba(0,0,0,0.06)'; rect(618,368,242,4);

  // Horizontal canopy band (src y=316–332, x=484–860)
  ctx.fillStyle='#2c3038'; rect(484,316,376,16);
  ctx.fillStyle='rgba(255,255,255,0.08)'; rect(484,316,376,3);

  // Right wing windows
  ctx.fillStyle='#1e2428';
  win(628,232,672,270); win(680,232,724,270);
  win(732,232,776,270); win(784,232,828,270);
  win(836,232,858,270);
  win(628,312,672,350); win(680,312,724,350);
  win(732,312,776,350); win(784,312,828,350);
  // Large ground floor openings right wing
  win(628,370,718,432); win(730,370,820,432);

  // ── STAIR TOWER (src x=860–990) — 3 stepped levels ──
  // Level 1 (white, tallest): x=860–916, y=244–440
  ctx.fillStyle='#ececea'; rect(860,244,56,196);
  ctx.fillStyle='#e0dedc'; rect(858,236,60,10);
  ctx.fillStyle='#c8c6c2'; rect(858,236,60,4);
  ctx.fillStyle='rgba(0,0,0,0.07)'; rect(860,248,56,7);
  // Level 2 (slightly grey): x=916–958, y=268–440
  ctx.fillStyle='#dcdad6'; rect(916,268,42,172);
