function drawShoe(x,y,s){ctx.save();ctx.translate(x,y);ctx.fillStyle='rgba(0,0,0,0.15)';ctx.beginPath();ctx.ellipse(0,s*0.04,s*0.38,s*0.05,0,0,Math.PI*2);ctx.fill();
