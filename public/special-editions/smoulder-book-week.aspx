function drawSnake(x,y,s){
  // Cartoon orange snake — coiled body with raised smiling head, like the reference image
  // Colours: body #e87800 (orange), belly #f5c060 (light orange/yellow), darker outline #c05800
  ctx.save();ctx.translate(x,y);

  const BODY='#e87800';
  const BODY_DARK='#c05000';
  const BODY_LIGHT='#f09030';
  const BELLY='#f5c060';
  const OUTLINE='#a03800';

  // Ground shadow
  ctx.fillStyle='rgba(0,0,0,0.15)';
  ctx.beginPath();ctx.ellipse(0,s*0.12,s*0.5,s*0.08,0,0,Math.PI*2);ctx.fill();

  // ── COILED BODY ──
  // Outer coil ring — thick stroked ellipse
  ctx.strokeStyle=BODY_DARK;ctx.lineWidth=s*0.28;ctx.lineCap='round';
  ctx.beginPath();ctx.ellipse(0,s*0.04,s*0.38,s*0.14,0,0,Math.PI*2);ctx.stroke();
  // Colour fill on top of outline
  ctx.strokeStyle=BODY;ctx.lineWidth=s*0.22;
  ctx.beginPath();ctx.ellipse(0,s*0.04,s*0.38,s*0.14,0,0,Math.PI*2);ctx.stroke();
  // Belly stripe on coil — lighter colour on inner edge
  ctx.strokeStyle=BELLY;ctx.lineWidth=s*0.1;
  ctx.beginPath();ctx.ellipse(0,s*0.04,s*0.38,s*0.14,0,Math.PI*0.6,Math.PI*1.4);ctx.stroke();

  // Inner coil (second loop, smaller)
  ctx.strokeStyle=BODY_DARK;ctx.lineWidth=s*0.2;
  ctx.beginPath();ctx.ellipse(s*0.04,s*0.05,s*0.2,s*0.08,0.2,0,Math.PI*1.7);ctx.stroke();
  ctx.strokeStyle=BODY;ctx.lineWidth=s*0.15;
  ctx.beginPath();ctx.ellipse(s*0.04,s*0.05,s*0.2,s*0.08,0.2,0,Math.PI*1.7);ctx.stroke();

  // Tail tip — small curved point
  ctx.strokeStyle=BODY_DARK;ctx.lineWidth=s*0.1;
  ctx.beginPath();ctx.moveTo(-s*0.38,s*0.04);ctx.bezierCurveTo(-s*0.48,s*0.0,-s*0.5,-s*0.06,-s*0.44,-s*0.1);ctx.stroke();
  ctx.strokeStyle=BODY;ctx.lineWidth=s*0.07;
  ctx.beginPath();ctx.moveTo(-s*0.38,s*0.04);ctx.bezierCurveTo(-s*0.48,s*0.0,-s*0.5,-s*0.06,-s*0.44,-s*0.1);ctx.stroke();

  // ── NECK rising from coil ──
  // Neck as a thick curved stroke from coil top up to head
  ctx.strokeStyle=BODY_DARK;ctx.lineWidth=s*0.28;
  ctx.beginPath();ctx.moveTo(s*0.1,s*0.0);ctx.bezierCurveTo(s*0.18,-s*0.12,s*0.1,-s*0.3,s*0.0,-s*0.38);ctx.stroke();
  ctx.strokeStyle=BODY;ctx.lineWidth=s*0.22;
  ctx.beginPath();ctx.moveTo(s*0.1,s*0.0);ctx.bezierCurveTo(s*0.18,-s*0.12,s*0.1,-s*0.3,s*0.0,-s*0.38);ctx.stroke();
  // Belly on neck
  ctx.strokeStyle=BELLY;ctx.lineWidth=s*0.1;
  ctx.beginPath();ctx.moveTo(s*0.18,-s*0.04);ctx.bezierCurveTo(s*0.24,-s*0.14,s*0.17,-s*0.3,s*0.06,-s*0.38);ctx.stroke();

  // ── HEAD ──
  // Head shadow
  ctx.fillStyle=BODY_DARK;
  ctx.beginPath();ctx.ellipse(s*0.02,-s*0.52,s*0.24,s*0.2,0,0,Math.PI*2);ctx.fill();
  // Main head — rounded, slightly wider than tall (cartoon style)
  const hg=ctx.createRadialGradient(-s*0.06,-s*0.58,s*0.02,s*0.02,-s*0.52,s*0.26);
  hg.addColorStop(0,BODY_LIGHT);hg.addColorStop(0.6,BODY);hg.addColorStop(1,BODY_DARK);
  ctx.fillStyle=hg;
  ctx.beginPath();ctx.ellipse(s*0.02,-s*0.52,s*0.22,s*0.18,0,0,Math.PI*2);ctx.fill();

  // Cheeks — slight bulge
  ctx.fillStyle=BODY_DARK;
  ctx.beginPath();ctx.ellipse(-s*0.18,-s*0.54,s*0.08,s*0.07,0,0,Math.PI*2);ctx.fill();
  ctx.beginPath();ctx.ellipse(s*0.22,-s*0.54,s*0.08,s*0.07,0,0,Math.PI*2);ctx.fill();
  ctx.fillStyle=BODY;
  ctx.beginPath();ctx.ellipse(-s*0.17,-s*0.54,s*0.07,s*0.06,0,0,Math.PI*2);ctx.fill();
  ctx.beginPath();ctx.ellipse(s*0.21,-s*0.54,s*0.07,s*0.06,0,0,Math.PI*2);ctx.fill();

  // Snout / lower face — lighter belly colour
  ctx.fillStyle=BELLY;
  ctx.beginPath();ctx.ellipse(s*0.02,-s*0.44,s*0.16,s*0.1,0,0,Math.PI*2);ctx.fill();

  // ── OPEN SMILING MOUTH ──
  // Lower jaw dropped open
  ctx.fillStyle=OUTLINE;
  ctx.beginPath();ctx.ellipse(s*0.02,-s*0.38,s*0.13,s*0.07,0,0,Math.PI*2);ctx.fill();
  // Pink mouth interior
  ctx.fillStyle='#e84060';
  ctx.beginPath();ctx.ellipse(s*0.02,-s*0.37,s*0.11,s*0.055,0,0,Math.PI*2);ctx.fill();
  // Tongue — forked
  ctx.strokeStyle='#cc1040';ctx.lineWidth=s*0.04;ctx.lineCap='round';
  ctx.beginPath();ctx.moveTo(s*0.02,-s*0.33);ctx.lineTo(s*0.02,-s*0.26);ctx.stroke();
  ctx.beginPath();ctx.moveTo(s*0.02,-s*0.26);ctx.lineTo(-s*0.04,-s*0.21);ctx.stroke();
  ctx.beginPath();ctx.moveTo(s*0.02,-s*0.26);ctx.lineTo(s*0.08,-s*0.21);ctx.stroke();
  // Upper mouth line
  ctx.strokeStyle=OUTLINE;ctx.lineWidth=s*0.025;
  ctx.beginPath();ctx.moveTo(-s*0.1,-s*0.38);ctx.bezierCurveTo(-s*0.04,-s*0.4,s*0.08,-s*0.4,s*0.14,-s*0.38);ctx.stroke();

  // ── EYES — big cartoon eyes ──
  // Eye whites — large round
  ctx.fillStyle='#fff';
  ctx.beginPath();ctx.arc(-s*0.09,-s*0.56,s*0.1,0,Math.PI*2);ctx.fill();
  ctx.beginPath();ctx.arc(s*0.13,-s*0.56,s*0.1,0,Math.PI*2);ctx.fill();
  // Eye outline
  ctx.strokeStyle=OUTLINE;ctx.lineWidth=s*0.025;
  ctx.beginPath();ctx.arc(-s*0.09,-s*0.56,s*0.1,0,Math.PI*2);ctx.stroke();
  ctx.beginPath();ctx.arc(s*0.13,-s*0.56,s*0.1,0,Math.PI*2);ctx.stroke();
  // Iris — dark green tint (cartoon snake eyes)
  ctx.fillStyle='#2a6010';
  ctx.beginPath();ctx.arc(-s*0.07,-s*0.56,s*0.07,0,Math.PI*2);ctx.fill();
  ctx.beginPath();ctx.arc(s*0.11,-s*0.56,s*0.07,0,Math.PI*2);ctx.fill();
  // Pupil — large, round
  ctx.fillStyle='#111';
  ctx.beginPath();ctx.arc(-s*0.06,-s*0.56,s*0.045,0,Math.PI*2);ctx.fill();
  ctx.beginPath();ctx.arc(s*0.12,-s*0.56,s*0.045,0,Math.PI*2);ctx.fill();
  // Eye shine — two spots
  ctx.fillStyle='rgba(255,255,255,0.9)';
  ctx.beginPath();ctx.arc(-s*0.04,-s*0.59,s*0.022,0,Math.PI*2);ctx.fill();
  ctx.beginPath();ctx.arc(s*0.14,-s*0.59,s*0.022,0,Math.PI*2);ctx.fill();
  ctx.fillStyle='rgba(255,255,255,0.5)';
  ctx.beginPath();ctx.arc(-s*0.09,-s*0.52,s*0.012,0,Math.PI*2);ctx.fill();
  ctx.beginPath();ctx.arc(s*0.09,-s*0.52,s*0.012,0,Math.PI*2);ctx.fill();

  // Eyelid top line — gives friendly expression
  ctx.strokeStyle=OUTLINE;ctx.lineWidth=s*0.03;ctx.lineCap='round';
  ctx.beginPath();ctx.arc(-s*0.09,-s*0.56,s*0.1,-Math.PI*0.9,-Math.PI*0.1);ctx.stroke();
  ctx.beginPath();ctx.arc(s*0.13,-s*0.56,s*0.1,-Math.PI*0.9,-Math.PI*0.1);ctx.stroke();

  // Nostrils
  ctx.fillStyle=BODY_DARK;
  ctx.beginPath();ctx.arc(-s*0.04,-s*0.47,s*0.02,0,Math.PI*2);ctx.fill();
  ctx.beginPath();ctx.arc(s*0.08,-s*0.47,s*0.02,0,Math.PI*2);ctx.fill();

  // Scale pattern on body — subtle darker dots
  ctx.fillStyle='rgba(160,80,0,0.2)';
  [[-s*0.3,s*0.03],[s*0.28,s*0.02],[0,-s*0.0],[-s*0.15,s*0.06],[s*0.15,s*0.0]].forEach(([sx2,sy2])=>{
    ctx.beginPath();ctx.arc(sx2,sy2,s*0.04,0,Math.PI*2);ctx.fill();
  });

  ctx.restore();
}

