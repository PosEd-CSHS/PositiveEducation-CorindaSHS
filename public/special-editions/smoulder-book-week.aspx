// ── CROWD GENERATION ──
// Place students in horizontal bands (rows), fairly tightly packed
function generateCrowdPositions(){
  const positions=[];
  seed=SESSION_SEED;
  const rowYs=[];
  // Perspective rows: far rows (near building) small & tight, near rows large & spread
  for(let y=400;y<H-80;y++){
    const progress=Math.max(0,(y-400)/(H-80-400)); // 0=far, 1=near
    const rowH=Math.floor(28+progress*52); // row height 28px far, 80px near
    if(rowYs.length===0||y-rowYs[rowYs.length-1]>=rowH){
      rowYs.push(y);
    }
  }

  rowYs.forEach(rowY=>{
    const progress=Math.max(0,(rowY-400)/(H-80-400));
    const sz=Math.floor(38+progress*30); // 38px far, 68px near
    const spacing=sz*1.05+rF(0,sz*0.2);
    for(let x=-sz;x<W+sz;x+=spacing){
      const jx=rF(-sz*0.25,sz*0.25);
      const jy=rF(-sz*0.12,sz*0.12);
      // Genuine variety: ~33% each direction, varied poses, ~50/50 junior/senior
      const facingRoll=rand();
      const facing = facingRoll<0.33 ? 0 : facingRoll<0.66 ? 1 : 2;
      const flip = facing===1 ? true : facing===0 ? false : rand()>0.5;
      positions.push({
        x:x+jx,
        y:rowY+jy,
        size:sz+rF(-sz*0.08,sz*0.08), // slight size variation within row
        flip,
        junior:rand()>0.45,
        pose:rInt(0,3),
        facing,
        type:'student'
      });
    }
  });
  return positions;
}

// ── CLICK DETECTION ──
// Store bounding boxes for clickable hidden chars
let clickTargets=[];
// Track exact hidden-character instances across redraws.
// Without this, render() can recreate click boxes and let the same character count again.
let foundTargetIds=new Set();
let targetOrdinals={};

function addTarget(x,y,targetSize,key,label,stableId){
  const scale = CHAR_VISUAL_SCALE[key] || 1.0;
  const yOff  = CHAR_Y_OFFSET[key]    || 1.0;
  const s = targetSize * scale;
  const boxW  = s * 1.4;
  // Default human figures are ~centred on the anchor, so 0.5 above is enough.
  // Tall upward-drawn characters (horse, phoenix, trees, etc.) declare their reach.
  const rise  = CHAR_TOP_RISE[key] || 0.5;
  const topY  = y - s * yOff - s * rise;
  const boxH  = (y - topY) + s * 0.15;
  // Use stableId (crowd slot index) if provided, otherwise fall back to draw-order ordinal.
  // stableId prevents the same character getting a different ID after a re-render.
  let id;
  if(stableId !== undefined){
    id = key + '-' + stableId;
  } else {
    const ord = targetOrdinals[key] || 0;
    targetOrdinals[key] = ord + 1;
    id = key + '-' + ord;
  }
  clickTargets.push({
    x: x - boxW/2,
    y: topY,
    w: boxW,
    h: boxH,
    key, label, id,
    found: foundTargetIds.has(id)
  });
}


