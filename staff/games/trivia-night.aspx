function cshsAbsWeek(){
  try{
    var terms=window.CSHS_SITE_CONFIG.terms;
    var pd=function(s){var a=s.split('-');return new Date(+a[0],+a[1]-1,+a[2]);};
    var monday=function(d){var x=new Date(d);x.setDate(x.getDate()-((x.getDay()+6)%7));x.setHours(0,0,0,0);return x;};
    var today=new Date(); today.setHours(0,0,0,0);
    var abs=0, current=0;
    for(var i=0;i<terms.length;i++){
      var end=pd(terms[i].end), m=monday(pd(terms[i].start));
      while(m<=end){ abs++; if(m<=today){ current=abs; } m=new Date(m); m.setDate(m.getDate()+7); }
    }
    return current;
  }catch(e){ return 0; }
}

const STAGE_LABELS = ["This fortnight's focus","Rebus puzzle","What's this logo?","General knowledge","General knowledge","On the calendar"];
let round = null, stage = 0, score = 0, answered = false;

function currentWeekRound(){
  const abs = cshsAbsWeek();
  const idx = (abs >= 1 && abs <= ROUNDS.length) ? abs - 1 : 0;
  return ROUNDS[idx];
}

function stageData(){
  switch(stage){
    case 0: return {kind:'text', ...round.virtueQ};
    case 1: return {kind:'rebus', clue: round.rebus.clue, choices: rebusChoices(), a: 0};
    case 2: return {kind:'logo', svg: LOGO_SVGS[round.logoIdx], choices: logoChoices(), a: logoAnswerIdx};
    case 3: return {kind:'text', ...round.gk[0]};
    case 4: return {kind:'text', ...round.gk[1]};
    case 5: return {kind:'text', ...round.calendar};
    default: return null;
  }
}

let logoAnswerIdx = 0;
function logoChoices(){
  // 3 distractor logo names, deterministic per week+stage
  const names = LOGO_SVGS_NAMES;
  const correct = round.logo.name;
  const others = names.filter(n => n !== correct);
  const seed = round.week * 13 + 7;
  const s = seededShuffle(others, seed).slice(0,3);
  const all = seededShuffle([correct, ...s], seed + 1);
  logoAnswerIdx = all.indexOf(correct);
  return all;
}
function rebusChoices(){
  const correct = round.rebus.answer;
  const pool = ROUNDS.filter(r => r.week !== round.week).map(r => r.rebus.answer);
  const seed = round.week * 17 + 3;
  const s = seededShuffle(pool, seed).slice(0,3);
  const all = seededShuffle([correct, ...s], seed + 1);
  return all;
}
function seededShuffle(arr, seed){
  const a=[...arr]; let s=seed;
  for(let i=a.length-1;i>0;i--){ s=(s*9301+49297)%233280; const j=Math.floor((s/233280)*(i+1)); [a[i],a[j]]=[a[j],a[i]]; }
  return a;
}

const weekTag=document.getElementById('weekTag'),progressDots=document.getElementById('progressDots'),
  stageLabel=document.getElementById('stageLabel'),questionBox=document.getElementById('questionBox'),
  questionText=document.getElementById('questionText'),choicesBox=document.getElementById('choicesBox'),
  feedback=document.getElementById('feedback'),noteBox=document.getElementById('noteBox'),
  nextBtn=document.getElementById('nextBtn'),playView=document.getElementById('playView'),
  resultView=document.getElementById('resultView'),scoreBig=document.getElementById('scoreBig'),
  scoreSub=document.getElementById('scoreSub');

function renderProgress(){
  progressDots.innerHTML = STAGE_LABELS.map((_,i)=>{
    const cls = i < stage ? 'dot done' : (i === stage ? 'dot current' : 'dot');
    return `<span class="${cls}"></span>`;
  }).join('');
}

function renderStage(){
  answered = false;
  nextBtn.disabled = true;
  nextBtn.textContent = stage === STAGE_LABELS.length - 1 ? 'See results' : 'Next round';
  feedback.textContent = '';
  feedback.className = 'feedback';
  noteBox.className = 'note-box';
  noteBox.textContent = '';
  renderProgress();
  const d = stageData();
  stageLabel.textContent = STAGE_LABELS[stage];

  if (d.kind === 'rebus') {
    questionBox.innerHTML = `<div class="rebus-clue">${d.clue}</div>`;
  } else if (d.kind === 'logo') {
    questionBox.innerHTML = `<div class="logo-wrap">${d.svg}</div>`;
  } else {
    questionBox.innerHTML = `<div class="question-text"></div>`;
    questionBox.querySelector('.question-text').textContent = d.q;
  }

  choicesBox.innerHTML = '';
  d.choices.forEach((choice, i) => {
    const btn = document.createElement('button');
    btn.className = 'choice-btn';
    btn.textContent = choice;
    btn.addEventListener('click', () => selectChoice(i, d));
    choicesBox.appendChild(btn);
  });
}

function selectChoice(i, d){
  if (answered) return;
  answered = true;
  const buttons = [...choicesBox.querySelectorAll('.choice-btn')];
  buttons.forEach((b, idx) => {
    b.disabled = true;
    if (idx === d.a) b.classList.add('correct');
    else if (idx === i) b.classList.add('wrong');
  });
  if (i === d.a) {
    score++;
    feedback.textContent = 'Correct!';
    feedback.className = 'feedback right';
  } else {
    feedback.textContent = 'Not quite — correct answer highlighted.';
    feedback.className = 'feedback wrong';
  }
  if (round.calendar.note && stage === 5) {
    noteBox.textContent = round.calendar.note;
    noteBox.className = 'note-box show';
  }
  nextBtn.disabled = false;
}

function nextRound(){
  stage++;
  if (stage >= STAGE_LABELS.length) {
    showResults();
  } else {
    renderStage();
  }
}

function showResults(){
  playView.style.display = 'none';
  resultView.style.display = '';
  scoreBig.textContent = score + ' / ' + STAGE_LABELS.length;
  const msgs = ['Have another crack next fortnight!','A solid effort.','Nice work.','Great round!','Trivia Night champions!'];
  const bracket = Math.min(Math.floor(score / STAGE_LABELS.length * msgs.length), msgs.length - 1);
  scoreSub.textContent = msgs[bracket];
}

function init(){
  round = currentWeekRound();
  weekTag.textContent = 'Term ' + round.term + ' · Week ' + round.weekInTerm;
  stage = 0; score = 0;
  playView.style.display = '';
  resultView.style.display = 'none';
  renderStage();
}

nextBtn.addEventListener('click', nextRound);
document.getElementById('playAgainBtn').addEventListener('click', init);
document.getElementById('backBtn').addEventListener('click', () => {
  window.location.href = (window.CSHS_SITE_CONFIG && window.CSHS_SITE_CONFIG.gamesHubUrl) || '../index.html';
});

init();
</script>
