function drawDragon(x,y,s){ctx.save();ctx.translate(x,y);ctx.fillStyle='rgba(0,0,0,0.15)';ctx.beginPath();ctx.ellipse(0,s*0.04,s*0.4,s*0.07,0,0,Math.PI*2);ctx.fill();
  ctx.fillStyle='#2f8a52';
  ctx.beginPath();ctx.moveTo(-s*0.1,-s*0.3);ctx.quadraticCurveTo(-s*0.5,-s*0.7,-s*0.46,-s*0.2);ctx.quadraticCurveTo(-s*0.3,-s*0.28,-s*0.1,-s*0.1);ctx.closePath();ctx.fill();
  ctx.beginPath();ctx.moveTo(s*0.1,-s*0.3);ctx.quadraticCurveTo(s*0.5,-s*0.7,s*0.46,-s*0.2);ctx.quadraticCurveTo(s*0.3,-s*0.28,s*0.1,-s*0.1);ctx.closePath();ctx.fill();
  ctx.fillStyle='#3cae68';ctx.beginPath();ctx.ellipse(0,-s*0.16,s*0.2,s*0.24,0,0,Math.PI*2);ctx.fill();
  ctx.beginPath();ctx.ellipse(0,-s*0.56,s*0.18,s*0.16,0,0,Math.PI*2);ctx.fill();
  ctx.fillStyle='#4cc078';ctx.beginPath();ctx.ellipse(s*0.02,-s*0.48,s*0.12,s*0.08,0,0,Math.PI*2);ctx.fill();
  ctx.fillStyle='#e8d878';for(let i=0;i<3;i++){ctx.beginPath();ctx.ellipse(0,-s*0.08-i*s*0.12,s*0.07,s*0.05,0,0,Math.PI*2);ctx.fill();}
  ctx.beginPath();ctx.moveTo(-s*0.08,-s*0.68);ctx.lineTo(-s*0.12,-s*0.82);ctx.lineTo(-s*0.02,-s*0.7);ctx.closePath();ctx.fill();
  ctx.beginPath();ctx.moveTo(s*0.08,-s*0.68);ctx.lineTo(s*0.12,-s*0.82);ctx.lineTo(s*0.02,-s*0.7);ctx.closePath();ctx.fill();
  ctx.fillStyle='#fff';ctx.beginPath();ctx.arc(-s*0.05,-s*0.58,s*0.035,0,Math.PI*2);ctx.arc(s*0.07,-s*0.58,s*0.035,0,Math.PI*2);ctx.fill();
  ctx.fillStyle='#1a1a1a';ctx.beginPath();ctx.arc(-s*0.04,-s*0.58,s*0.018,0,Math.PI*2);ctx.arc(s*0.08,-s*0.58,s*0.018,0,Math.PI*2);ctx.fill();
  ctx.fillStyle='rgba(255,255,255,0.5)';ctx.beginPath();ctx.arc(s*0.12,-s*0.46,s*0.03,0,Math.PI*2);ctx.fill();
  ctx.restore();}

function drawOwl(x,y,s){ctx.save();ctx.translate(x,y);ctx.fillStyle='rgba(0,0,0,0.15)';ctx.beginPath();ctx.ellipse(0,s*0.04,s*0.26,s*0.05,0,0,Math.PI*2);ctx.fill();
  ctx.fillStyle='#8a6a44';ctx.beginPath();ctx.ellipse(0,-s*0.36,s*0.24,s*0.32,0,0,Math.PI*2);ctx.fill();
