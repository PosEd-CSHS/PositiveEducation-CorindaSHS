function drawBouquet(x,y,s){ctx.save();ctx.translate(x,y);ctx.fillStyle='rgba(0,0,0,0.15)';ctx.beginPath();ctx.ellipse(0,s*0.04,s*0.26,s*0.05,0,0,Math.PI*2);ctx.fill();
  ctx.strokeStyle='#3c8c3c';ctx.lineWidth=s*0.03;
  [-s*0.1,0,s*0.1].forEach(dx=>{ctx.beginPath();ctx.moveTo(dx*0.3,-s*0.1);ctx.lineTo(dx,-s*0.55);ctx.stroke();});
  const fl=[[-s*0.14,-s*0.6,'#e85c8a'],[s*0.0,-s*0.7,'#f0a0c0'],[s*0.14,-s*0.62,'#e0407a']];
  fl.forEach(([fx,fy,col])=>{ctx.fillStyle=col;for(let k=0;k<5;k++){const a=k/5*Math.PI*2;ctx.beginPath();ctx.ellipse(fx+Math.cos(a)*s*0.06,fy+Math.sin(a)*s*0.06,s*0.05,s*0.05,0,0,Math.PI*2);ctx.fill();}
    ctx.fillStyle='#f5d020';ctx.beginPath();ctx.arc(fx,fy,s*0.04,0,Math.PI*2);ctx.fill();});
  ctx.fillStyle='#d0a0c0';ctx.beginPath();ctx.moveTo(-s*0.12,-s*0.1);ctx.lineTo(s*0.12,-s*0.1);ctx.lineTo(s*0.06,-s*0.02);ctx.lineTo(-s*0.06,-s*0.02);ctx.closePath();ctx.fill();ctx.restore();}

function drawPinkRibbon(x,y,s){ctx.save();ctx.translate(x,y);ctx.fillStyle='rgba(0,0,0,0.15)';ctx.beginPath();ctx.ellipse(0,s*0.04,s*0.2,s*0.04,0,0,Math.PI*2);ctx.fill();
  // awareness-ribbon loop: two crossing bands
  ctx.fillStyle='#f06aa8';
  ctx.beginPath();
  ctx.moveTo(-s*0.02,-s*0.06);                 // bottom tail left
  ctx.bezierCurveTo(-s*0.26,-s*0.5,-s*0.18,-s*0.78,s*0.02,-s*0.62);  // up left, over top
  ctx.bezierCurveTo(s*0.06,-s*0.58,s*0.06,-s*0.5,s*0.02,-s*0.46);
  ctx.bezierCurveTo(-s*0.1,-s*0.62,-s*0.12,-s*0.4,s*0.04,-s*0.06);   // back down
  ctx.closePath();ctx.fill();
  ctx.fillStyle='#e0488a';
  ctx.beginPath();
  ctx.moveTo(s*0.02,-s*0.06);
  ctx.bezierCurveTo(s*0.26,-s*0.5,s*0.18,-s*0.78,-s*0.02,-s*0.62);
  ctx.bezierCurveTo(-s*0.06,-s*0.58,-s*0.06,-s*0.5,-s*0.02,-s*0.46);
  ctx.bezierCurveTo(s*0.1,-s*0.62,s*0.12,-s*0.4,-s*0.04,-s*0.06);
  ctx.closePath();ctx.fill();ctx.restore();}

function drawPyjamas(x,y,s){ctx.save();ctx.translate(x,y);ctx.fillStyle='rgba(0,0,0,0.15)';ctx.beginPath();ctx.ellipse(0,s*0.04,s*0.3,s*0.05,0,0,Math.PI*2);ctx.fill();
  // simple striped onesie body
  ctx.fillStyle='#8ab0e0';ctx.beginPath();ctx.moveTo(-s*0.2,-s*0.04);ctx.lineTo(-s*0.22,-s*0.5);ctx.lineTo(s*0.22,-s*0.5);ctx.lineTo(s*0.2,-s*0.04);ctx.closePath();ctx.fill();
  ctx.strokeStyle='#5a80b8';ctx.lineWidth=s*0.025;for(let i=0;i<4;i++){const yy=-s*0.1-i*s*0.1;ctx.beginPath();ctx.moveTo(-s*0.21,yy);ctx.lineTo(s*0.21,yy);ctx.stroke();}
  // head
  ctx.fillStyle='#f0c8a0';ctx.beginPath();ctx.arc(0,-s*0.62,s*0.16,0,Math.PI*2);ctx.fill();
  // nightcap
  ctx.fillStyle='#e06a9a';ctx.beginPath();ctx.moveTo(-s*0.16,-s*0.66);ctx.lineTo(s*0.16,-s*0.66);ctx.lineTo(s*0.26,-s*0.92);ctx.closePath();ctx.fill();
  ctx.fillStyle='#fff';ctx.beginPath();ctx.arc(s*0.26,-s*0.92,s*0.05,0,Math.PI*2);ctx.fill();
  // closed sleepy eyes
  ctx.strokeStyle='#5a3c28';ctx.lineWidth=s*0.02;ctx.beginPath();ctx.moveTo(-s*0.08,-s*0.62);ctx.lineTo(-s*0.02,-s*0.62);ctx.moveTo(s*0.02,-s*0.62);ctx.lineTo(s*0.08,-s*0.62);ctx.stroke();ctx.restore();}

function drawJumper(x,y,s){ctx.save();ctx.translate(x,y);ctx.fillStyle='rgba(0,0,0,0.15)';ctx.beginPath();ctx.ellipse(0,s*0.04,s*0.32,s*0.05,0,0,Math.PI*2);ctx.fill();
  ctx.fillStyle='#b06030';ctx.beginPath();
  ctx.moveTo(-s*0.3,-s*0.5);ctx.lineTo(-s*0.42,-s*0.36);ctx.lineTo(-s*0.34,-s*0.24);ctx.lineTo(-s*0.24,-s*0.32);
  ctx.lineTo(-s*0.24,-s*0.04);ctx.lineTo(s*0.24,-s*0.04);ctx.lineTo(s*0.24,-s*0.32);
  ctx.lineTo(s*0.34,-s*0.24);ctx.lineTo(s*0.42,-s*0.36);ctx.lineTo(s*0.3,-s*0.5);
  ctx.bezierCurveTo(s*0.1,-s*0.6,-s*0.1,-s*0.6,-s*0.3,-s*0.5);ctx.closePath();ctx.fill();
  // daggy zigzag pattern
  ctx.strokeStyle='#f0d040';ctx.lineWidth=s*0.03;ctx.beginPath();
  for(let i=0;i<5;i++){const xx=-s*0.2+i*s*0.1;ctx.lineTo(xx,(i%2?-s*0.2:-s*0.3));}ctx.stroke();
  ctx.fillStyle='#3c8c5c';ctx.beginPath();ctx.arc(-s*0.1,-s*0.14,s*0.04,0,Math.PI*2);ctx.arc(s*0.1,-s*0.14,s*0.04,0,Math.PI*2);ctx.fill();ctx.restore();}

function drawSpeech(x,y,s){ctx.save();ctx.translate(x,y);ctx.fillStyle='rgba(0,0,0,0.15)';ctx.beginPath();ctx.ellipse(0,s*0.04,s*0.3,s*0.05,0,0,Math.PI*2);ctx.fill();
  ctx.fillStyle='#f5d020';ctx.beginPath();
  ctx.moveTo(-s*0.3,-s*0.8);ctx.lineTo(s*0.3,-s*0.8);ctx.quadraticCurveTo(s*0.38,-s*0.8,s*0.38,-s*0.5);ctx.lineTo(s*0.38,-s*0.32);ctx.quadraticCurveTo(s*0.38,-s*0.24,s*0.3,-s*0.24);
  ctx.lineTo(-s*0.1,-s*0.24);ctx.lineTo(-s*0.18,-s*0.06);ctx.lineTo(-s*0.18,-s*0.24);ctx.lineTo(-s*0.3,-s*0.24);
  ctx.quadraticCurveTo(-s*0.38,-s*0.24,-s*0.38,-s*0.32);ctx.lineTo(-s*0.38,-s*0.72);ctx.quadraticCurveTo(-s*0.38,-s*0.8,-s*0.3,-s*0.8);ctx.closePath();ctx.fill();
  ctx.fillStyle='#3a3000';ctx.font='bold '+(s*0.16)+'px Nunito';ctx.textAlign='center';ctx.fillText('R U OK?',0,-s*0.46);ctx.restore();}

function drawMask(x,y,s){ctx.save();ctx.translate(x,y);ctx.fillStyle='rgba(0,0,0,0.15)';ctx.beginPath();ctx.ellipse(0,s*0.04,s*0.3,s*0.05,0,0,Math.PI*2);ctx.fill();
  // stick
  ctx.strokeStyle='#a0701e';ctx.lineWidth=s*0.03;ctx.beginPath();ctx.moveTo(s*0.18,-s*0.3);ctx.lineTo(s*0.26,-s*0.02);ctx.stroke();
  ctx.fillStyle='#8c3ca8';ctx.beginPath();ctx.ellipse(0,-s*0.5,s*0.3,s*0.22,0,0,Math.PI*2);ctx.fill();
  // eye holes
  ctx.fillStyle='#5e9a';ctx.save();ctx.globalCompositeOperation='destination-out';
  ctx.beginPath();ctx.ellipse(-s*0.12,-s*0.52,s*0.07,s*0.05,0,0,Math.PI*2);ctx.ellipse(s*0.12,-s*0.52,s*0.07,s*0.05,0,0,Math.PI*2);ctx.fill();ctx.restore();
  // feathers
  ctx.fillStyle='#f0c040';ctx.beginPath();ctx.moveTo(-s*0.2,-s*0.66);ctx.lineTo(-s*0.3,-s*0.92);ctx.lineTo(-s*0.1,-s*0.7);ctx.closePath();ctx.fill();
  ctx.fillStyle='#e06a9a';ctx.beginPath();ctx.moveTo(s*0.0,-s*0.7);ctx.lineTo(s*0.0,-s*0.98);ctx.lineTo(s*0.12,-s*0.72);ctx.closePath();ctx.fill();
  ctx.fillStyle='#f5d83c';ctx.beginPath();for(let k=0;k<6;k++){const a=k/6*Math.PI*2;ctx.beginPath();ctx.arc(-s*0.12+Math.cos(a)*0,-s*0.52,s*0.01,0,Math.PI*2);}ctx.fill();ctx.restore();}

function drawCrazyHair(x,y,s){ctx.save();ctx.translate(x,y);ctx.fillStyle='rgba(0,0,0,0.15)';ctx.beginPath();ctx.ellipse(0,s*0.04,s*0.3,s*0.05,0,0,Math.PI*2);ctx.fill();
  // body
  ctx.fillStyle='#3c8c5c';ctx.beginPath();ctx.moveTo(-s*0.2,-s*0.04);ctx.lineTo(-s*0.2,-s*0.42);ctx.lineTo(s*0.2,-s*0.42);ctx.lineTo(s*0.2,-s*0.04);ctx.closePath();ctx.fill();
  // head
  ctx.fillStyle='#f0c8a0';ctx.beginPath();ctx.arc(0,-s*0.56,s*0.16,0,Math.PI*2);ctx.fill();
  // crazy multicolour hair spikes
  const hc=['#e84c4c','#f0a030','#f5d83c','#3ca050','#4070c8','#9040c0'];
  for(let i=0;i<9;i++){const a=Math.PI*(0.1+0.8*i/8);const hx=Math.cos(a)*s*0.16,hy=-s*0.56-Math.sin(a)*s*0.16;
    ctx.strokeStyle=hc[i%hc.length];ctx.lineWidth=s*0.04;ctx.beginPath();ctx.moveTo(hx,hy);ctx.lineTo(Math.cos(a)*s*0.34,-s*0.56-Math.sin(a)*s*0.34);ctx.stroke();}
  // smile + eyes
  ctx.fillStyle='#3a2818';ctx.beginPath();ctx.arc(-s*0.06,-s*0.58,s*0.02,0,Math.PI*2);ctx.arc(s*0.06,-s*0.58,s*0.02,0,Math.PI*2);ctx.fill();
  ctx.strokeStyle='#3a2818';ctx.lineWidth=s*0.02;ctx.beginPath();ctx.arc(0,-s*0.52,s*0.06,0.1*Math.PI,0.9*Math.PI);ctx.stroke();ctx.restore();}

function drawGradCap(x,y,s){ctx.save();ctx.translate(x,y);ctx.fillStyle='rgba(0,0,0,0.15)';ctx.beginPath();ctx.ellipse(0,s*0.04,s*0.26,s*0.05,0,0,Math.PI*2);ctx.fill();
  // student head
  ctx.fillStyle='#f0c8a0';ctx.beginPath();ctx.ellipse(0,-s*0.28,s*0.16,s*0.18,0,0,Math.PI*2);ctx.fill();
  // mortarboard base
  ctx.fillStyle='#1e1e28';ctx.beginPath();ctx.moveTo(-s*0.1,-s*0.42);ctx.lineTo(s*0.1,-s*0.42);ctx.lineTo(s*0.1,-s*0.5);ctx.lineTo(-s*0.1,-s*0.5);ctx.closePath();ctx.fill();
  // board (diamond)
  ctx.fillStyle='#181822';ctx.beginPath();ctx.moveTo(0,-s*0.62);ctx.lineTo(s*0.34,-s*0.48);ctx.lineTo(0,-s*0.34);ctx.lineTo(-s*0.34,-s*0.48);ctx.closePath();ctx.fill();
  // button + tassel
  ctx.fillStyle='#f0c828';ctx.beginPath();ctx.arc(0,-s*0.48,s*0.03,0,Math.PI*2);ctx.fill();
  ctx.strokeStyle='#f0c828';ctx.lineWidth=s*0.025;ctx.beginPath();ctx.moveTo(0,-s*0.48);ctx.lineTo(s*0.28,-s*0.42);ctx.lineTo(s*0.3,-s*0.2);ctx.stroke();
  ctx.beginPath();ctx.arc(s*0.3,-s*0.16,s*0.04,0,Math.PI*2);ctx.fill();ctx.restore();}

// ── DECORATIONS (NOT findable, NOT scored) — flags & commemorative items ──
// Drawn into the scene during their week as respectful set dressing only.
function drawAusFlag(x,y,s){ctx.save();ctx.translate(x,y);
  const fw=s*1.3, fh=s*0.9;
  ctx.fillStyle='#785a32';ctx.fillRect(-3,-fh-s*0.12,4,fh+s*0.5);            // pole
  ctx.fillStyle='#00284a'.replace('00284a','002868');ctx.fillRect(0,-fh,fw,fh); // blue field
  const cw=fw*0.5,ch=fh*0.5;
  ctx.strokeStyle='#fff';ctx.lineWidth=s*0.04;
  ctx.beginPath();ctx.moveTo(0,-fh);ctx.lineTo(cw,-fh+ch);ctx.moveTo(cw,-fh);ctx.lineTo(0,-fh+ch);ctx.stroke();
  ctx.fillStyle='#c8102e';ctx.fillRect(cw*0.42,-fh,cw*0.16,ch);ctx.fillRect(0,-fh+ch*0.42,cw,ch*0.16);
  function star(cx,cy,r,pts){ctx.fillStyle='#fff';ctx.beginPath();for(let i=0;i<pts*2;i++){const a=Math.PI/pts*i-Math.PI/2;const rr=i%2?r*0.45:r;const px=cx+Math.cos(a)*rr,py=cy+Math.sin(a)*rr;i?ctx.lineTo(px,py):ctx.moveTo(px,py);}ctx.closePath();ctx.fill();}
  star(cw*0.5,-fh+ch+fh*0.08,fh*0.12,7);  // Commonwealth star
  [[0.72,0.25,0.07],[0.86,0.45,0.06],[0.70,0.62,0.06],[0.82,0.78,0.05],[0.76,0.5,0.03]].forEach(([sx,sy,sr])=>star(fw*sx,-fh+fh*sy,fh*sr,7));
  ctx.restore();}

function drawAboriginalFlag(x,y,s){ctx.save();ctx.translate(x,y);
  const fw=s*1.3, fh=s*0.9;
  ctx.fillStyle='#785a32';ctx.fillRect(-3,-fh-s*0.12,4,fh+s*0.5);
  ctx.fillStyle='#000';ctx.fillRect(0,-fh,fw,fh*0.5);
  ctx.fillStyle='#cc2000';ctx.fillRect(0,-fh*0.5,fw,fh*0.5);
  ctx.fillStyle='#ffc800';ctx.beginPath();ctx.arc(fw*0.5,-fh*0.5,fh*0.22,0,Math.PI*2);ctx.fill();
  ctx.restore();}

function drawTorresStraitFlag(x,y,s){ctx.save();ctx.translate(x,y);
  const fw=s*1.3, fh=s*0.9;
  ctx.fillStyle='#785a32';ctx.fillRect(-3,-fh-s*0.12,4,fh+s*0.5);
  ctx.fillStyle='#00643c';ctx.fillRect(0,-fh,fw,fh);                       // green
  ctx.fillStyle='#005aa0';ctx.fillRect(0,-fh+fh*0.18,fw,fh*0.64);          // blue band
  ctx.fillStyle='#000';ctx.fillRect(0,-fh+fh*0.15,fw,fh*0.03);ctx.fillRect(0,-fh*0.18-fh*0.03+fh*0.18,fw,fh*0.03);
  ctx.fillStyle='#000';ctx.fillRect(0,-fh*0.18,fw,fh*0.03);
  const cx=fw*0.5,cy=-fh*0.5;
  // dhari (white headdress arc + rays)
  ctx.strokeStyle='#fff';ctx.lineWidth=s*0.04;
  ctx.beginPath();ctx.arc(cx,cy+fh*0.04,fh*0.26,Math.PI,Math.PI*2);ctx.stroke();
  for(let k=0;k<5;k++){const a=Math.PI+(k+0.5)/5*Math.PI;ctx.beginPath();ctx.moveTo(cx,cy+fh*0.04);ctx.lineTo(cx+Math.cos(a)*fh*0.28,cy+fh*0.04+Math.sin(a)*fh*0.28);ctx.stroke();}
  // white 5-point star below
  ctx.fillStyle='#fff';ctx.beginPath();for(let i=0;i<10;i++){const a=Math.PI/5*i-Math.PI/2;const rr=i%2?fh*0.06:fh*0.14;const px=cx+Math.cos(a)*rr,py=cy+fh*0.12+Math.sin(a)*rr;i?ctx.lineTo(px,py):ctx.moveTo(px,py);}ctx.closePath();ctx.fill();
  ctx.restore();}

// Both First Nations flags side by side — used for Reconciliation & NAIDOC weeks.
function drawDualIndigenousFlags(x,y,s){
  drawAboriginalFlag(x, y, s);
  drawTorresStraitFlag(x + s*1.6, y, s);
}

