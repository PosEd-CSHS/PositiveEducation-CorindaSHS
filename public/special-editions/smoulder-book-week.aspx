  ctx.fillStyle='#f5efe0';ctx.beginPath();ctx.moveTo(0,-s*0.5);ctx.quadraticCurveTo(-s*0.36,-s*0.62,-s*0.4,-s*0.2);ctx.quadraticCurveTo(-s*0.36,-s*0.02,0,-s*0.08);ctx.closePath();ctx.fill();
