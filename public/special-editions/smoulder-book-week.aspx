  ctx.fillStyle='#1a1a1a';ctx.beginPath();ctx.arc(-s*0.08,-s*0.5,s*0.025,0,Math.PI*2);ctx.arc(s*0.08,-s*0.5,s*0.025,0,Math.PI*2);ctx.fill();
  ctx.fillStyle='#e8961e';ctx.beginPath();ctx.moveTo(0,-s*0.44);ctx.lineTo(-s*0.03,-s*0.38);ctx.lineTo(s*0.03,-s*0.38);ctx.closePath();ctx.fill();
  ctx.strokeStyle='#e8961e';ctx.lineWidth=s*0.02;ctx.beginPath();ctx.moveTo(-s*0.06,-s*0.06);ctx.lineTo(-s*0.06,0);ctx.moveTo(s*0.06,-s*0.06);ctx.lineTo(s*0.06,0);ctx.stroke();
