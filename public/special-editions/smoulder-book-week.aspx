  // head
  ctx.fillStyle='#f0f0ec';ctx.beginPath();ctx.ellipse(s*0.5,-s*0.44,s*0.14,s*0.18,0.15,0,Math.PI*2);ctx.fill();
  // black patch on head
  ctx.fillStyle='#1a1a1a';ctx.beginPath();ctx.ellipse(s*0.44,-s*0.5,s*0.09,s*0.07,-0.3,0,Math.PI*2);ctx.fill();
  // ears
  ctx.fillStyle='#f0f0ec';ctx.beginPath();ctx.ellipse(s*0.38,-s*0.56,s*0.05,s*0.1,-0.4,0,Math.PI*2);ctx.fill();
  ctx.beginPath();ctx.ellipse(s*0.6,-s*0.54,s*0.05,s*0.1,0.4,0,Math.PI*2);ctx.fill();
  ctx.fillStyle='#f0c0c0';ctx.beginPath();ctx.ellipse(s*0.38,-s*0.56,s*0.025,s*0.06,-0.4,0,Math.PI*2);ctx.fill();
  // horns
  ctx.strokeStyle='#c8a840';ctx.lineWidth=s*0.05;ctx.lineCap='round';
  ctx.beginPath();ctx.moveTo(s*0.42,-s*0.6);ctx.bezierCurveTo(s*0.38,-s*0.74,s*0.3,-s*0.76,s*0.32,-s*0.66);ctx.stroke();
  ctx.beginPath();ctx.moveTo(s*0.56,-s*0.6);ctx.bezierCurveTo(s*0.62,-s*0.74,s*0.7,-s*0.72,s*0.66,-s*0.62);ctx.stroke();
  // snout
  ctx.fillStyle='#f0c0b0';ctx.beginPath();ctx.ellipse(s*0.6,-s*0.36,s*0.09,s*0.07,0,0,Math.PI*2);ctx.fill();
  ctx.fillStyle='#c07060';ctx.beginPath();ctx.arc(s*0.55,-s*0.36,s*0.025,0,Math.PI*2);ctx.fill();
  ctx.beginPath();ctx.arc(s*0.65,-s*0.36,s*0.025,0,Math.PI*2);ctx.fill();
  // eye
  ctx.fillStyle='#1a0a00';ctx.beginPath();ctx.arc(s*0.44,-s*0.44,s*0.04,0,Math.PI*2);ctx.fill();
  ctx.fillStyle='#fff';ctx.beginPath();ctx.arc(s*0.45,-s*0.46,s*0.014,0,Math.PI*2);ctx.fill();
  ctx.restore();
}

