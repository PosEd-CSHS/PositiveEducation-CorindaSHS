function drawHiddenChar(key, x, y, targetSize, juniorFlag, genderIdx, clip) {
  // targetSize = the crowd student size at this position (26–80px)
  // We scale it so the character appears similar height to a student
  const scale = CHAR_VISUAL_SCALE[key] || 1.0;
  const yOff  = CHAR_Y_OFFSET[key]    || 1.0;
  const s = targetSize * scale;
  // Shift y so bottom of character sits at y (feet on ground)
  const drawY = y - s * yOff + s * yOff; // feet at y: drawY = y
  // Actually: character's bottom is at drawY + s*yOff
  // We want that = y, so drawY = y - s*yOff
  const adjustedY = y - s * yOff;

  if (clip) {
    ctx.save();
    ctx.beginPath();
    ctx.rect(clip.x, clip.y, clip.w, clip.h);
    ctx.clip();
  }
  const fn = CHAR_FN_MAP[key];
  if(fn) fn(x, adjustedY, s);
  if (clip) ctx.restore();
}

function drawPhoenixMascot(x,y,s){
  // Phoenix mascot drawn from embedded PNG illustration
  // Grey background removed using multiply blend mode
  if(!window._phoenixImg){
    window._phoenixImg = new Image();
    window._phoenixImg.onload = function(){
      window._phoenixLoaded = true;
      if (typeof render === 'function') render();
    };
    window._phoenixImg.src = 'data:image/png;base64,';
  }
  const img = window._phoenixImg;
  ctx.save();
  ctx.translate(x,y);
  // Image has grey background — draw with source image proportions
  // Source is roughly square (portrait). Scale so height = s*1.8 (person height)
  // and centre horizontally. Feet are at ~88% down the image.
  const imgH = s * 2.1;        // total render height
  const imgW = imgH * 0.82;    // source aspect ratio ~0.82
  const feetFrac = 0.88;       // feet at 88% down source image
  const yOff = -imgH * feetFrac; // shift up so feet land at y=0
  if(img.complete && img.naturalHeight > 0){
    ctx.drawImage(img, -imgW/2, yOff, imgW, imgH);
  } else {
    // Fallback while loading
    ctx.fillStyle='#f5c800';
    ctx.beginPath();ctx.arc(0,-s*0.8,s*0.5,0,Math.PI*2);ctx.fill();
    ctx.fillStyle='#1a6030';
    ctx.fillRect(-s*0.4,-s*0.5,s*0.8,s*0.5);
  }
  ctx.restore();
}

