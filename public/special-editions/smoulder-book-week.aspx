  ctx.moveTo(-s*0.4,-s*0.02);ctx.lineTo(s*0.42,-s*0.02);ctx.quadraticCurveTo(s*0.46,-s*0.1,s*0.36,-s*0.12);ctx.lineTo(-s*0.38,-s*0.12);ctx.closePath();ctx.fill();
  // upper (sneaker)
  ctx.fillStyle='#e84c4c';ctx.beginPath();
  ctx.moveTo(-s*0.38,-s*0.12);ctx.lineTo(-s*0.38,-s*0.28);ctx.quadraticCurveTo(-s*0.36,-s*0.44,-s*0.18,-s*0.44);
