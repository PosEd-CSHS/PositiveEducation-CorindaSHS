  // Add this edition's extras to the find-list (once), or ensure they're present.
  EVENT_EXTRAS.forEach(t=>{
    if (document.getElementById('fi-'+t.key)) return;
    const div=document.createElement('div');
    div.className='fi';
    div.id='fi-'+t.key;
    div.style.cssText='background:#2a1a00;border:1px solid #f2b400;';  // subtle highlight
    div.textContent='⭐ '+t.label+' ×'+t.count;
    const scoreEl=document.getElementById('score');
    scoreEl.parentNode.insertBefore(div, scoreEl);
  });
  document.querySelectorAll('.fi').forEach(el=>el.classList.remove('found'));
  document.getElementById('score').textContent='0 / '+TOTAL;
  document.getElementById('win').classList.remove('show');
  resetTimer();
  render();
  applyZoom();
}

